---
// ヒーローの粒子を、本文では余白を流れる小さな光として引き継ぐ。
const motes = Array.from({ length: 8 }, (_, i) => ({
  x: [5, 91, 16, 84, 8, 95, 24, 76][i],
  y: 12 + (i * 17) % 78,
  size: i % 3 === 0 ? 2 : 1,
  duration: 12 + i % 4 * 2,
  delay: -i * 2.3,
  dx: i % 2 === 0 ? 28 : -22,
}));
---

<template id="site-motion-template">
  <div class="ambient-field" aria-hidden="true">
    {motes.map((m) => <i style={`--x:${m.x}%;--y:${m.y}%;--size:${m.size}px;--duration:${m.duration}s;--delay:${m.delay}s;--dx:${m.dx}px`}></i>)}
  </div>
</template>

<script>
  const template = document.querySelector<HTMLTemplateElement>('#site-motion-template');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (template && 'IntersectionObserver' in window) {
    // セクション単位で背景だけを隔離する。ヒーローの暗幕・文字の重なりには触れない。
    const surfaces = document.querySelectorAll<HTMLElement>(
      '.page > section:is(.band, .phead, .contact), .site-foot',
    );
    surfaces.forEach((surface, i) => {
      surface.classList.add('motion-surface');
      surface.style.setProperty('--ambient-phase', `${-i * 3.7}s`);
      surface.prepend(template.content.cloneNode(true));
    });

    const targets = [...surfaces, ...document.querySelectorAll<HTMLElement>('.photo-frame')];
    const visible = new Set<Element>();
    const sync = () => {
      const enabled = !document.hidden && !reducedMotion.matches;
      targets.forEach((target) => target.classList.toggle('motion-active', enabled && visible.has(target)));
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRect.height > 0) visible.add(entry.target);
        else visible.delete(entry.target);
      });
      sync();
    });
    targets.forEach((target) => observer.observe(target));
    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    window.addEventListener('pagehide', () => targets.forEach((target) => target.classList.remove('motion-active')));
    window.addEventListener('pageshow', sync);
  }
</script>

<style is:global>
  .motion-surface{position:relative;isolation:isolate;--motion-play:paused}
  .motion-active{--motion-play:running}
  .motion-surface>.ambient-field{
    position:absolute;inset:0;max-height:1600px;z-index:-1;pointer-events:none;overflow:hidden;
    contain:strict;--ambient-rgb:116,151,192;
    /* 長い記事一覧でもレイヤーの大きさを制限し、端は背景に溶かす。 */
    mask-image:linear-gradient(transparent,#000 80px,#000 calc(100% - 80px),transparent);
  }
  .ambient-field::before,.ambient-field::after{
    content:'';position:absolute;width:85%;height:min(65%,580px);left:-20%;top:8%;
    background:radial-gradient(ellipse at center,rgba(var(--ambient-rgb),.09),rgba(var(--ambient-rgb),.025) 35%,transparent 68%);
    transform:rotate(-22deg);opacity:.8;
  }
  .ambient-field::after{left:48%;top:48%;height:min(42%,420px);opacity:.5}
  .ambient-field>i{
    position:absolute;left:var(--x);top:var(--y);width:var(--size);height:var(--size);
    border-radius:50%;background:rgba(var(--ambient-rgb),.65);opacity:0;
    box-shadow:0 0 7px rgba(var(--ambient-rgb),.25);
  }
  .band--paper>.ambient-field{--ambient-rgb:142,111,69;opacity:.65}

  /* 写真の枠を固定し、その内側だけを数％動かす。 */
  .photo-frame{
    position:relative;overflow:hidden;min-width:0;aspect-ratio:16/10;
    border:1px solid var(--rule);border-radius:2px;--motion-play:paused;
  }
  .photo-frame.motion-active{--motion-play:running}
  .band--paper .photo-frame{border-color:var(--paper-rule)}
  .photo-frame--tall{aspect-ratio:3/4}
  .photo-frame--wide{aspect-ratio:auto}
  .photo-frame>img{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:0}

  @media(prefers-reduced-motion:no-preference){
    .ambient-field::before,.ambient-field::after{
      animation:ambient-light 22s ease-in-out infinite alternate;
      animation-delay:var(--ambient-phase,0s);animation-play-state:var(--motion-play);
    }
    .ambient-field::after{animation-name:ambient-light-return;animation-duration:29s}
    .ambient-field>i{
      animation:ambient-mote var(--duration) linear infinite;
      animation-delay:calc(var(--delay) + var(--ambient-phase,0s));animation-play-state:var(--motion-play);
    }
    .motion-surface .label::after{
      background-color:var(--rule);
      background-image:linear-gradient(90deg,transparent,rgba(183,210,237,.65),transparent);
      background-size:42px 100%;background-repeat:no-repeat;
      animation:ambient-signal 7s ease-in-out infinite;
      animation-delay:var(--ambient-phase,0s);animation-play-state:var(--motion-play);
    }
    .band--paper.motion-surface .label::after{
      background-color:var(--paper-rule);
      background-image:linear-gradient(90deg,transparent,rgba(142,111,69,.6),transparent);
    }
    .photo-frame>img{
      animation:photo-breathe 16s ease-in-out infinite alternate;
      animation-play-state:var(--motion-play);
    }
    .photo-frame:nth-child(even)>img{animation-direction:alternate-reverse;animation-duration:19s}
  }
  @keyframes ambient-light{
    from{transform:translate(-6%,-5%) rotate(-22deg);opacity:.5}
    to{transform:translate(26%,20%) rotate(-12deg);opacity:1}
  }
  @keyframes ambient-light-return{
    from{transform:translate(8%,12%) rotate(-18deg);opacity:.3}
    to{transform:translate(-24%,-16%) rotate(-28deg);opacity:.7}
  }
  @keyframes ambient-mote{
    0%,100%{opacity:0}
    18%,72%{opacity:.55}
    from{transform:translate(0,30px)}
    to{transform:translate(var(--dx),-80px)}
  }
  @keyframes ambient-signal{
    0%{background-position:-48px 0}
    65%,100%{background-position:calc(100% + 48px) 0}
  }
  @keyframes photo-breathe{
    from{transform:scale(1.025) translate(-.4%,.3%)}
    to{transform:scale(1.065) translate(.4%,-.3%)}
  }
  @media(max-width:600px){
    .photo-frame--wide{aspect-ratio:16/9}
    .ambient-field>i:nth-child(n+6){display:none}
  }
  @media(prefers-reduced-motion:reduce){
    .ambient-field{display:none}
  }
</style>
