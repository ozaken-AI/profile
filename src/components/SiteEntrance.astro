<div class="site-entrance" aria-hidden="true">
  <canvas class="entrance-field"></canvas>
</div>

<script>
  // 余白を流れる光の糸 → 実際の見出しの字形 → 継続するホコリ。
  // すべてヒーロー内の同じ座標で描き、別画面への切り替えを作らない。
  const entrance = document.querySelector<HTMLElement>('.site-entrance');
  const hero = entrance?.closest<HTMLElement>('.hero');
  const canvas = entrance?.querySelector<HTMLCanvasElement>('canvas');
  const headline = hero?.querySelector<HTMLElement>('.hero-h1 em');
  const line = headline?.closest<HTMLElement>('.line');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-reduced-motion: reduce)');
  const ctx = canvas?.getContext('2d');

  if (entrance && hero && canvas && ctx && headline && line && !media.matches && !document.hidden && window.scrollY < 80) {
    const box = hero.getBoundingClientRect();
    const width = box.width, height = box.height;
    const compact = window.innerWidth <= 860;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    ctx.scale(dpr, dpr);

    const mask = document.createElement('canvas');
    const ink = mask.getContext('2d', { willReadFrequently: true });
    if (ink) {
      let letterBox = { left: 0, top: 0, width: 0, height: 0 };
      function sampleHeadline() {
        const style = getComputedStyle(headline!);
        const lineBox = line!.getBoundingClientRect();
        const heroBox = hero!.getBoundingClientRect();
        const size = parseFloat(style.fontSize);
        const lineHeight = parseFloat(style.lineHeight) || size * 1.08;
        letterBox = { left: lineBox.left - heroBox.left, top: lineBox.top - heroBox.top,
          width: headline!.getBoundingClientRect().width, height: lineHeight };
        const padding = Math.ceil(size * .4);
        mask.width = Math.ceil(lineBox.width + padding * 2);
        mask.height = Math.ceil(lineHeight + padding * 2);
        ink!.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
        if ('letterSpacing' in ink!) ink!.letterSpacing = style.letterSpacing;
        const word = headline!.textContent || '';
        const metrics = ink!.measureText(word);
        const ascent = metrics.fontBoundingBoxAscent || size * .88;
        const descent = metrics.fontBoundingBoxDescent || size * .12;
        const baseline = (lineHeight - ascent - descent) / 2 + ascent;
        ink!.fillText(word, padding, padding + baseline);
        const pixels = ink!.getImageData(0, 0, mask.width, mask.height).data;
        const targets: { x: number; y: number }[] = [];
        const spacing = compact ? 2 : 3;
        for (let y = padding; y < padding + lineHeight; y += spacing) {
          for (let x = padding; x < mask.width - padding; x += spacing) {
            if (pixels[(y * mask.width + x) * 4 + 3] > 128) {
              targets.push({ x: lineBox.left - heroBox.left + x - padding,
                y: lineBox.top - heroBox.top + y - padding });
            }
          }
        }
        return targets;
      }
      let targets = sampleHeadline();
      const count = Math.min(targets.length, compact ? 650 : 1000);
      const points = Array.from({ length: count }, (_, i) => ({
        lane: i % 6, seed: (i * .618034) % 1,
        depth: .3 + (i % 11) / 15,
      }));
      const dust = [...hero.querySelectorAll<HTMLElement>('.spot-dust b')];
      let driftDust: HTMLElement[] | null = null;
      // 見出し付近の余白に6本の流れを置く。顔のある上部へは描かない。
      function threadPoint(u: number, lane: number, time: number) {
        const margin = Math.min(90, width * .2);
        const amplitude = Math.min(40, letterBox.height * .42);
        return {
          x: letterBox.left - margin + u * (letterBox.width + margin * 2),
          y: letterBox.top + letterBox.height * .85
            + Math.sin(u * 4.4 + lane * .66 - time * 1.9) * amplitude
            + (lane - 2.5) * amplitude * .28,
        };
      }
      const smooth = (v: number) => { const t = Math.max(0, Math.min(1, v)); return t * t * (3 - 2 * t); };
      let raf = 0, ended = false;
      const start = performance.now();
      hero.classList.add('intro-reveal');
      root.dataset.intro = 'running';
      const events = new AbortController();
      function finish() {
        if (ended) return;
        ended = true;
        cancelAnimationFrame(raf);
        clearTimeout(failsafe);
        events.abort();
        root.dataset.intro = 'done';
        entrance!.remove();
        hero!.classList.add('intro-complete');
      }
      const failsafe = window.setTimeout(finish, 3200);
      for (const event of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
        window.addEventListener(event, finish, { once: true, passive: true, signal: events.signal });
      }
      window.addEventListener('resize', finish, { signal: events.signal });
      window.addEventListener('pagehide', finish, { signal: events.signal });
      document.addEventListener('visibilitychange', finish, { signal: events.signal });
      media.addEventListener('change', finish, { signal: events.signal });
      // 初期フォントの差し替えを吸収。文字へ集まり始めたあとは位置を跳ばさない。
      document.fonts.ready.then(() => {
        if (!ended && performance.now() - start < 700) targets = sampleHeadline();
      });

      function draw(now: number) {
        const t = (now - start) / 1000;
        if (t >= 2.9 || !targets.length) { finish(); return; }
        ctx!.clearRect(0, 0, width, height);
        const appear = smooth(t / .2);
        const release = smooth((t - 1.75) / 1.05);
        // 文字より下にある粒子へ渡し、ほどけた光も顔の上を横切らない。
        if (release > 0 && !driftDust) {
          driftDust = dust.filter(el => el.getBoundingClientRect().top - box.top >= letterBox.top + letterBox.height * .4);
        }
        const destinations = (driftDust || []).map(el => {
          const rect = el.getBoundingClientRect();
          return { x: rect.left - box.left + rect.width / 2, y: rect.top - box.top + rect.height / 2 };
        });
        const projected = points.map((p, i) => {
          const target = targets[Math.floor(i * targets.length / count)];
          const gather = smooth((t - .5 - (i % 7) * .016) / .83);
          const arc = Math.sin(gather * Math.PI);
          const u = p.seed * 1.2 - .25 + t * (.2 + p.depth * .12);
          const source = threadPoint(u, p.lane, t);
          const tail = threadPoint(u - .018 - p.depth * .012, p.lane, t);
          let px = source.x * (1 - gather) + target.x * gather;
          let py = source.y * (1 - gather) + target.y * gather + arc * letterBox.height * .16 * p.seed;
          if (destinations.length) {
            const end = destinations[i % destinations.length];
            px = px * (1 - release) + end.x * release;
            py = py * (1 - release) + end.y * release;
          }
          return { x: px, y: py, tailX: px + (tail.x - source.x) * (1 - gather),
            tailY: py + (tail.y - source.y) * (1 - gather),
            alpha: appear * (1 - release) * (.2 + p.depth * .6), depth: p.depth, gather };
        });
        const threads = appear * (1 - smooth((t - .45) / .8));
        if (threads > .01) {
          ctx!.lineWidth = .6;
          ctx!.strokeStyle = `rgba(190,210,240,${.2 * threads})`;
          for (let lane = 0; lane < 6; lane++) {
            ctx!.beginPath();
            for (let step = 0; step <= 64; step++) {
              const point = threadPoint(step / 64, lane, t);
              if (step === 0) ctx!.moveTo(point.x, point.y);
              else ctx!.lineTo(point.x, point.y);
            }
            ctx!.stroke();
          }
        }
        projected.forEach((p, i) => {
          if (i % 6 === 0 && p.gather < .98) {
            ctx!.lineWidth = .6 + p.depth * .4;
            ctx!.strokeStyle = `rgba(210,223,244,${p.alpha * .6})`;
            ctx!.beginPath(); ctx!.moveTo(p.tailX, p.tailY); ctx!.lineTo(p.x, p.y); ctx!.stroke();
          }
          ctx!.fillStyle = `rgba(235,243,255,${p.alpha})`;
          const size = .65 + p.depth * 1.1;
          ctx!.fillRect(p.x, p.y, size, size);
        });
        raf = requestAnimationFrame(draw);
      }
      raf = requestAnimationFrame(draw);
    } else { root.dataset.intro = 'done'; entrance.remove(); }
  } else { root.dataset.intro = 'done'; entrance?.remove(); }
</script>

<style is:global>
  .site-entrance{display:none}
  @media(prefers-reduced-motion:no-preference){
    html[data-intro='pending'] .site-entrance,
    html[data-intro='running'] .site-entrance{
      display:block;position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden;
      animation:entrance-clear 3.2s step-end both;
    }
    .entrance-field{
      position:absolute;inset:0;width:100%;height:100%;
      mask-image:linear-gradient(90deg,transparent,#000 16px,#000 calc(100% - 16px),transparent);
    }
    /* JSの読み込みが失敗しても、写真と本文はCSSだけで最終表示になる。 */
    html[data-intro='pending'] .hero .hero-actor,
    .hero.intro-reveal.on .hero-actor{animation:portrait-awaken 2.5s var(--ease) both}
    html[data-intro='pending'] .hero .line>span,
    .hero.intro-reveal.on .line>span{transition:none;transform:none}
    html[data-intro='pending'] .hero .hero-h1 em,
    .hero.intro-reveal.on .hero-h1 em{transition:none;animation:headline-ignite 2.9s ease both}
    html[data-intro='pending'] .hero .spot-dust,
    .hero.intro-reveal .spot-dust{animation:dust-handoff 2.9s ease both}
  }
  .hero.intro-complete.on .hero-actor{animation:none;opacity:1;transform:none}
  .hero.intro-complete.on .hero-h1 em{animation:none;opacity:1;color:#fff}
  .hero.intro-complete .spot-dust{animation:none;opacity:.95}
  .hero.intro-complete.on .hero-eyebrow,.hero.intro-complete.on .line>span,
  .hero.intro-complete.on .hero-sub,.hero.intro-complete.on .hero-actions,.hero.intro-complete.on .hero-foot{transition:none;opacity:1;transform:none}
  @keyframes entrance-clear{to{visibility:hidden;opacity:0}}
  @keyframes portrait-awaken{0%{opacity:.35;transform:scale(1.018)}50%{opacity:.85}100%{opacity:1;transform:none}}
  @keyframes headline-ignite{0%,30%{opacity:.25;color:var(--fg-mid);text-shadow:none}54%{opacity:.4}72%,100%{opacity:1;color:#fff;text-shadow:0 0 34px rgba(190,210,255,.26)}}
  @keyframes dust-handoff{0%,45%{opacity:.08}100%{opacity:.95}}
</style>
