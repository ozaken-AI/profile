---
import { AFFILIATIONS } from '../lib/site';
---
<div class="affiliations wrap">
  <p>所属・役職・活動を通じて関わる組織</p>
  <ul>{AFFILIATIONS.map((name) => <li>{name}</li>)}</ul>
  <a href="/about/">役職・関わり方を見る <span aria-hidden="true">→</span></a>
</div>
<style>
  .affiliations{padding-block:1.5rem;border-block:1px solid var(--rule)}
  p,a{font-size:.875rem;color:var(--fg-mid)}
  ul{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;list-style:none;margin:.8rem 0}
  li{font-size:.9rem}a{text-decoration:underline;text-underline-offset:4px}
</style>
