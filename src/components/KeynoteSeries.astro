---
import { KEYNOTE_SERIES, MENU, SITE } from '../lib/site';
import ServiceDetails from './ServiceDetails.astro';
const keynote = MENU[0];
---

<section class="band band--paper keynote-series" id="keynote-series" data-rail="講演シリーズ">
  <div class="wrap">
    <p class="print-identity">{SITE.name} ／ {SITE.role}<br />{SITE.url}/speaking/ ／ {SITE.email}</p>
    <p class="label rv">Talks ／ 講演</p>
    <h2 class="h2 rv">{KEYNOTE_SERIES.title}</h2>
    <p class="lede rv">{KEYNOTE_SERIES.lead}</p>

    <p class="keynote-note rv">1テーマからご依頼いただけます。連続開催を前提とせず、開催趣旨に合わせてテーマを組み合わせることもできます。</p>
    <nav class="keynote-nav rv" aria-label="講演のテーマ">
      {KEYNOTE_SERIES.talks.map((talk) => <a href={`#${talk.id}`}>{talk.number} {talk.category} <span aria-hidden="true">↓</span></a>)}
    </nav>
    <div class="keynote-talks">
      {KEYNOTE_SERIES.talks.map((talk) => (
        <article class="keynote-talk" id={talk.id} aria-labelledby={`${talk.id}-title`}>
          <header class="rv">
            <p class="keynote-category">{talk.number} ／ {talk.category} <span lang="en">{talk.english}</span></p>
            <h3 class="keynote-title" id={`${talk.id}-title`}>{talk.title}</h3>
            <p class="keynote-subtitle">{talk.subtitle}</p>
          </header>
          <p class="print-abstract">{talk.description}</p>
              <div class="keynote-takeaway">
                <h4>持ち帰る視点</h4>
                <p>{talk.takeaway}</p>
              </div>
            <dl class="keynote-audience">
              <div><dt>対象</dt><dd>{talk.forWhom}</dd></div>
              <div><dt>開催の例</dt><dd>{talk.occasion}</dd></div>
            </dl>

          <details class="talk-more rv">
            <summary>講演の内容・関連資料を見る</summary>
            <p class="keynote-description">{talk.description}</p>
            <div class="keynote-detail">
              <div>
                <h4>講演で扱う論点</h4>
                <ul>{talk.points.map((point) => <li>{point}</li>)}</ul>
              </div>
            </div>
            <div class="keynote-sources">
              <p>関連する解説資料 <span>／ 閲覧にはキーが必要です</span></p>
              <ul>{talk.sources.map((source) => (
                <li><a href={new URL(source.path, SITE.contentSite).href} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a></li>
              ))}</ul>
            </div>
          </details>
          <div class="talk-actions">
            <a class="btn" href={`/contact/?kind=keynote&topic=${talk.id}`} data-place="keynote-theme">このテーマで相談する <span aria-hidden="true">→</span></a>
            <button type="button" data-print-talk={talk.id}>企画概要を印刷</button>
            <button type="button" data-share-talk={talk.id}>共有リンクをコピー</button>
          </div>
        </article>
      ))}
    </div>
    <p class="keynote-note rv">事例や技術動向は開催時点の情報で調整します。</p>
    <p class="print-conditions">形式：60〜90分（質疑応答を含む）／会場・オンライン・ハイブリッド。費用は個別見積もり。開催趣旨と参加者に合わせて構成します。<br />お問い合わせ：{SITE.email} ／ {SITE.url}/contact/</p>
    <p class="talk-status" role="status" aria-live="polite"></p>
    <ServiceDetails item={keynote}>
      <details class="program-more" id="program">
        <summary>カンファレンス・60分の構成例を見る</summary>
        <p class="keynote-note">「AI時代、企業の価値はどこに宿るのか」の場合。開催趣旨や後続セッションに合わせ、事例と時間配分を調整します。</p>
        <ol class="program-list">
          <li><span>10分</span><div><h3>企業の価値を問い直す</h3><p>AIによって変わる事業の前提を共有し、講演を通じて考える問いを置く。</p></div></li>
          <li><span>20分</span><div><h3>既存事業の強みを捉え直す</h3><p>顧客との関係、一次情報、現場の知が、どのように価値につながるかを考える。</p></div></li>
          <li><span>20分</span><div><h3>経営と組織の意思決定へ</h3><p>事業の再定義、投資の優先順位、人間が担う役割をつなぎ、次に議論する論点を整理する。</p></div></li>
          <li><span>10分</span><div><h3>質疑応答・次の議論へ</h3><p>参加者の疑問を深め、続くセッションや自社での検討につながる問いを共有する。</p></div></li>
        </ol>
      </details>
    </ServiceDetails>
  </div>
</section>

<style>
  .keynote-series{--keynote-fg:var(--fg);--keynote-muted:var(--fg-mid);--keynote-rule:var(--rule)}
  .keynote-series.band--paper{--keynote-fg:var(--paper-fg);--keynote-muted:var(--paper-mute);--keynote-rule:var(--paper-rule)}
  .keynote-note{font-size:.86rem;color:var(--keynote-muted);max-width:52em;margin-top:1.3rem}
  .keynote-note a,.keynote-sources a{border-bottom:1px solid var(--keynote-rule)}
  .keynote-series a:focus-visible{outline:2px solid currentColor;outline-offset:6px}
  .keynote-nav{display:flex;flex-wrap:wrap;gap:.7rem 2rem;margin-top:2rem;font-size:.9rem}
  .keynote-nav a{border-bottom:1px solid var(--keynote-rule);padding:.35rem 0}
  .keynote-nav span{margin-left:1rem}
  .keynote-talks{margin-top:2.6rem}
  .keynote-talk{border-top:1px solid var(--keynote-rule);padding:clamp(2.4rem,5vw,4rem) 0;scroll-margin-top:2rem}
  .keynote-talk:last-child{border-bottom:1px solid var(--keynote-rule)}
  .keynote-category{font-family:var(--f-en);font-size:.8rem;letter-spacing:.08em;color:var(--keynote-muted)}
  .keynote-category span{margin-left:1rem;font-size:.72rem;letter-spacing:.13em}
  .keynote-title{font-family:var(--f-mincho);font-size:clamp(1.5rem,3.3vw,2.35rem);font-weight:500;line-height:1.6;margin-top:1rem;text-wrap:balance}
  .keynote-subtitle{font-size:clamp(.9rem,1.5vw,1.05rem);margin-top:.55rem;color:var(--keynote-muted)}
  .keynote-description{font-size:.96rem;line-height:2.05;max-width:56em;margin-top:1.5rem}
  .keynote-detail{display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;margin-top:2rem}
  .keynote-detail h4{font-size:.81rem;font-weight:500;letter-spacing:.06em;margin-bottom:.7rem}
  .keynote-detail ul{padding-left:1.15rem;display:grid;gap:.45rem}
  .keynote-detail li,.keynote-takeaway p{font-size:.9rem;color:var(--keynote-muted);line-height:1.95}
  .keynote-detail li::marker{color:var(--seal)}
  .keynote-takeaway{border-left:2px solid var(--keynote-rule);padding-left:1.5rem}
  .keynote-audience{margin-top:1.8rem;font-size:.8rem;color:var(--keynote-muted);display:grid;gap:.35rem}
  .keynote-audience>div{display:grid;grid-template-columns:5em 1fr;gap:1rem}
  .keynote-sources{font-size:.78rem;color:var(--keynote-muted);margin-top:1.5rem}
  .keynote-sources ul{list-style:none;display:flex;flex-wrap:wrap;gap:.35rem 1.5rem;margin-top:.4rem}
  .keynote-sources a:hover,.keynote-note a:hover{color:var(--keynote-fg);border-color:currentColor}
  .talk-more{margin-top:1.5rem}
  .program-more{border-bottom:1px solid var(--keynote-rule);scroll-margin-top:6rem;padding-bottom:1rem}
  summary{cursor:pointer;font-size:.86rem;padding:.65rem 0}
  summary:focus-visible{outline:2px solid currentColor;outline-offset:5px}
  .program-list{color:var(--keynote-fg);border-color:var(--keynote-rule);margin-block:1.5rem}
  .program-list li{border-color:var(--keynote-rule)}
  .program-list p,.program-list span{color:var(--keynote-muted)}
  @media(max-width:700px){
    .keynote-detail{grid-template-columns:1fr;gap:1.5rem}
    .keynote-takeaway{padding-left:1rem}
    .keynote-category span{display:block;margin:.4rem 0 0}
    .keynote-audience>div{grid-template-columns:4em 1fr;gap:.5rem}
    .keynote-sources p span{display:block}
  }
</style>

<script>
  const talkStatus = document.querySelector<HTMLElement>('.talk-status');
  document.querySelectorAll<HTMLButtonElement>('[data-share-talk]').forEach(button => {
    button.addEventListener('click', async () => {
      const link = new URL(`/speaking/#${button.dataset.shareTalk}`, location.origin).href;
      try {
        await navigator.clipboard.writeText(link);
        if (talkStatus) talkStatus.textContent = '共有リンクをコピーしました。';
        button.textContent = 'コピーしました';
        window.setTimeout(() => { button.textContent = '共有リンクをコピー'; }, 2500);
      } catch {
        if (talkStatus) { talkStatus.textContent = `共有リンク：${link}`; talkStatus.scrollIntoView({ block: 'nearest' }); }
      }
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-print-talk]').forEach(button => {
    button.addEventListener('click', () => {
      document.documentElement.dataset.printTalk = button.dataset.printTalk;
      window.print();
    });
  });
  window.addEventListener('afterprint', () => { delete document.documentElement.dataset.printTalk; });
</script>
<style>
  .keynote-detail{grid-template-columns:1fr}
  .keynote-takeaway{margin-top:1rem;padding:.8rem 1rem;background:rgba(150,170,200,.06)}
  .keynote-takeaway h4{font-size:.875rem;margin-bottom:.35rem;font-weight:500}
  .keynote-audience{font-size:.9rem;margin-top:1rem}
  .talk-actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.3rem}
  .talk-actions .btn{margin:0;font-size:.9rem}
  .talk-actions button{font:inherit;font-size:.875rem;color:inherit;border:0;border-bottom:1px solid currentColor;background:none;cursor:pointer;padding:.6rem 0}
  .print-identity,.print-conditions,.print-abstract{display:none}
  .talk-status{font-size:.875rem;overflow-wrap:anywhere}
</style>
<style is:global>
  @media print {
    @page {size:A4;margin:18mm}
    html,body{background:white!important;color:#111!important;font-size:12pt!important}
    .page{margin:0!important;padding:0!important}
    .rail,.site-head,.site-foot,.skip-link,.site-motion,.section-motion,.motion-field,.service-jumpbar,body::before,body::after{display:none!important}
    main>*:not(.keynote-series){display:none!important}
    .keynote-series{padding:0!important;background:white!important;color:#111!important}
    .keynote-series .wrap{padding:0!important;max-width:none!important}
    .keynote-series .rv,.keynote-series .h2{opacity:1!important;transform:none!important;clip-path:none!important;animation:none!important}
    .keynote-series>.wrap> :is(.label,.lede,.keynote-note,.keynote-nav,.service-details,.talk-status){display:none!important}
    .keynote-series .h2{font-size:17pt!important;margin:.5rem 0 1rem!important}
    .keynote-series .print-identity,.keynote-series .print-conditions,.keynote-series .print-abstract{display:block!important;font-size:10pt;line-height:1.7}
    .keynote-series .keynote-talks{margin:0!important}
    .keynote-series .keynote-talk{break-inside:avoid;padding:1rem 0!important;border-color:#aaa!important}
    .keynote-series .keynote-title{font-size:20pt!important;line-height:1.5!important}
    .keynote-series :is(p,dt,dd,h4){color:#111!important;font-size:11pt!important;line-height:1.8!important}
    .keynote-series .keynote-audience{margin:1rem 0!important}
    .keynote-series :is(.talk-more,.talk-actions,.keynote-category span){display:none!important}
    html[data-print-talk] .keynote-talk{display:none!important}
    html[data-print-talk='management'] #management,html[data-print-talk='organization'] #organization,html[data-print-talk='trends'] #trends{display:block!important}
    .keynote-series a{text-decoration:none!important}
  }
</style>
