---
import { SITE } from '../lib/site';
const year = 2026;
---
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="foot-vision">{SITE.vision}。</p>
        <p class="foot-mission">Mission — {SITE.mission}</p>
      </div>
      <nav class="foot-nav" aria-label="フッター">
        <a href="/speaking/">講演依頼</a>
        <a href="/news/">お知らせ</a>
        <a href="/about/">プロフィール</a>
        <a href="/press/">プレスキット</a>
        <a href="/contact/">お問い合わせ</a>
        <a href={SITE.contentSite} target="_blank" rel="noopener noreferrer">資料一覧</a>
        <a href={SITE.x} target="_blank" rel="noopener noreferrer">{SITE.xHandle}</a>
      </nav>
    </div>
    <div class="foot-row">
      <span>{SITE.name}／{SITE.role}</span>
      <span>© {year} ozaken.ai</span>
    </div>
  </div>
</footer>
