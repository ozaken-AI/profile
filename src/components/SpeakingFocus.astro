---
import { FORMATS, speakingHref } from '../lib/site';
---
<section class="band wrap speaking-focus" id="s-focus" data-rail="目的から選ぶ">
  <p class="label rv">Work with me</p>
  <h2 class="h2 rv">いまの課題から、<br />関わり方を選ぶ。</h2>
  <p class="lede rv">開催の目的や社内の課題に合わせて、講演・研修・継続支援をご相談いただけます。</p>
  <div class="purpose-list">
    {FORMATS.map((format, i) => <a class="purpose-item rv" href={speakingHref(format.slug)}>
      <span class="purpose-number">0{i + 1}</span>
      <div><h3>{format.purpose}</h3><p>{format.detail}</p></div>
      <span class="purpose-format">{format.label}<span aria-hidden="true">→</span></span>
    </a>)}
  </div>
  <div class="authority-links rv">
    <a href="https://aicx.jp/" target="_blank" rel="noopener noreferrer"><span>業界団体</span>AICX協会 代表理事 ↗</a>
    <a href="https://prtimes.jp/main/html/rd/p/000000115.000155740.html" target="_blank" rel="noopener noreferrer"><span>人材・スキルの検討</span>経済産業省 AXスキルWG委員 ↗</a>
    <a href="/about/#books"><span>著書</span>『生成AI導入の教科書』<br />『AIエージェントの教科書』 →</a>
  </div>
</section>
