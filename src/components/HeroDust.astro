---
// 奥・中・手前の3層。上昇と横揺れの周期を分け、流れに奥行きをつくる。
const motes = Array.from({ length: 36 }, (_, i) => {
  const depth = i % 3;
  return {
    x: 14 + (i * 37) % 80, y: 10 + (i * 29) % 82,
    size: [1.4, 2.4, 3.8][depth], duration: [17, 12, 8][depth] + i % 4,
    delay: -(i * 1.73), drift: [18, 32, 48][depth],
    rise: [160, 220, 280][depth], sway: 3 + (i % 5) * .7,
  };
});
---
<div class="spot-dust" aria-hidden="true">
  {motes.map(({ x, y, size, duration, delay, drift, rise, sway }) => (
    <i style={`--x:${x}%;--y:${y}%;--size:${size}px;--duration:${duration}s;--delay:${delay}s;--drift:${drift}px;--rise:${rise}px;--sway:${sway}s`}><b></b></i>
  ))}
</div>

<script>
  const dust = document.querySelector<HTMLElement>('.spot-dust');
  const hero = dust?.closest('.hero');
  if (dust && hero && 'IntersectionObserver' in window) {
    let inView = false;
    const update = () => {
      const active = inView && !document.hidden;
      dust.classList.toggle('is-active', active);
      hero.classList.toggle('fx-active', active);
    };
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      update();
    });
    observer.observe(hero);
    document.addEventListener('visibilitychange', update);
  }
</script>
