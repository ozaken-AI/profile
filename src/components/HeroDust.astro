---
// 位置と周期をずらし、同じ軌道を一斉に往復しないようにする。
const motes = [
  [42, 24, 2, 19, -4, 18, 46], [48, 67, 1.5, 27, -12, -16, 64],
  [53, 39, 3, 22, -9, 24, 58], [57, 14, 1.5, 31, -18, -20, 72],
  [59, 80, 2.5, 24, -7, 16, 62], [63, 53, 2, 29, -21, -26, 52],
  [66, 29, 3, 21, -13, 20, 66], [69, 70, 1.5, 33, -6, -18, 78],
  [72, 11, 2, 26, -17, 28, 54], [74, 44, 2.5, 23, -3, -22, 64],
  [77, 85, 2, 30, -22, 18, 70], [80, 61, 3, 20, -11, -24, 56],
  [83, 22, 1.5, 32, -25, 16, 80], [86, 48, 2, 25, -14, -20, 62],
  [89, 76, 2.5, 28, -8, 26, 68], [93, 34, 1.5, 34, -20, -18, 74],
];
---
<div class="spot-dust" aria-hidden="true">
  {motes.map(([x, y, size, duration, delay, drift, rise]) => (
    <i style={`--x:${x}%;--y:${y}%;--size:${size}px;--duration:${duration}s;--delay:${delay}s;--drift:${drift}px;--rise:-${rise}px`}></i>
  ))}
</div>

<script>
  const dust = document.querySelector<HTMLElement>('.spot-dust');
  const hero = dust?.closest('.hero');
  if (dust && hero && 'IntersectionObserver' in window) {
    let inView = false;
    const update = () => dust.classList.toggle('is-active', inView && !document.hidden);
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      update();
    });
    observer.observe(hero);
    document.addEventListener('visibilitychange', update);
  }
</script>
