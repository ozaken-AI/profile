---
import Base from '../../layouts/Base.astro';
import KeynoteSeries from '../../components/KeynoteSeries.astro';
import ServiceDetails from '../../components/ServiceDetails.astro';
import { SITE, MENU, FAQ, SPEAKING_TRACK, TRAINING_PROGRAMS, ADVISORY_AREAS, PRIVATE_ENGAGEMENTS, FORMATS, ORGANIZATION_CHALLENGES, speakingHref } from '../../lib/site';

const [, training, advisory] = MENU;
const advisoryTrack = SPEAKING_TRACK.find(group => group.label === '顧問・アドバイザリー')!;
const speakingTrack = SPEAKING_TRACK.filter(group => group !== advisoryTrack);
const steps = [
  { n: '01', h: '目的をうかがう', p: '対象者、課題、日程・期間をお知らせください。講演の企画段階や、社内の論点整理からでも構いません。' },
  { n: '02', h: '内容と条件を決める', p: '講演・研修・プロジェクトなど、目的に合う形をご提案。内容・範囲・費用・資料共有の条件をすり合わせます。' },
  { n: '03', h: '日程・契約を確定する', p: '実施日または支援期間、関与範囲などをご確認いただき、合意した内容に沿って準備を始めます。' },
];
const title = '生成AIの講演・研修・顧問／アドバイザー | 小澤健祐（おざけん）';
const description = '生成AIの講演、Gemini・Microsoft 365 Copilot研修、AI戦略・組織変革の顧問・アドバイザー。小澤健祐への依頼内容、実績、開催・契約条件をご案内します。経営の意思決定から全社へのAI活用浸透まで。費用は個別見積もりです。';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: '講演・研修・顧問', item: `${SITE.url}/speaking/` },
  ],
}, ...MENU.map((item) => ({
  '@context': 'https://schema.org', '@type': 'Service',
  '@id': `${SITE.url}/speaking/#service-${item.slug}`,
  name: item.title, serviceType: item.kind, description: item.body,
  url: `${SITE.url}${speakingHref(item.slug)}`, provider: { '@id': `${SITE.url}/#person` },
}))];
---
<Base {title} {description} {jsonLd} ogImage="/ogp-speaking.png"
  ogImageAlt="小澤健祐（おざけん）｜経営の問いから、組織の実践まで。講演・研修・顧問／アドバイザー" railInitial="依頼">

<section class="phead wrap" data-rail="依頼">
  <div class="phead-glow" aria-hidden="true"></div>
  <p class="label rv">Speaking &amp; Advisory</p>
  <h1 class="phead-h1 rv rv-d1">講演・研修から、<br />組織の変革まで。</h1>
  <p class="service-byline rv rv-d1">生成AI・AIエージェント ／ 小澤健祐（おざけん）</p>
  <p class="phead-lede rv rv-d2">経営層から現場の担当者まで。参加者や利用環境、検討している課題に合わせて、講演・研修・継続支援を組み立てます。</p>
  <div class="booking-strip rv rv-d2">
    <p><b>費用は個別見積もり。企画段階からご相談いただけます。</b></p>
    <a class="btn" href="/contact/" data-place="speaking-intro">内容・日程を相談する <span aria-hidden="true">→</span></a>
  </div>
  <nav class="format-nav rv" id="formats" aria-label="依頼内容を選ぶ">
    {FORMATS.map((format, i) => (
      <a href={speakingHref(format.slug)}>
        <span class="format-number">{String(i + 1).padStart(2, '0')} <span aria-hidden="true">↓</span></span>
        <strong>{format.label}</strong><span class="format-purpose">{format.purpose}</span><span class="format-detail">{format.detail}</span>
      </a>
    ))}
  </nav>
  <nav class="section-links rv" aria-label="実績と依頼条件">
    <a href="#engagements">研修実績</a><a href="#advisory-evidence">継続支援の実績</a><a href="#track">登壇先の一覧</a><a href="#conditions">費用・条件</a>
  </nav>
</section>

<nav class="service-jumpbar" aria-label="このページの依頼内容">
  {FORMATS.map((format) => <a href={speakingHref(format.slug)}>{format.shortLabel}</a>)}
</nav>
<KeynoteSeries />

<section class="band wrap" id="training" data-rail="研修・ワークショップ">
  <span id="topics" class="anchor-alias" aria-hidden="true"></span>
  <p class="label rv">Training &amp; Workshop</p>
  <h2 class="h2 rv">仕事で使える、<br /><span class="phrase">AIの研修と</span><span class="phrase">ワークショップ。</span></h2>
  <p class="lede rv">{training.lede}</p>
  <div class="training-programs">
    {TRAINING_PROGRAMS.map((program, i) => (
      <article class="training-program rv" id={program.id}>
        <span class="program-number">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3>{program.title}</h3>
          <p class="program-audience">対象：{program.audience}</p>
          <p class="program-lead">{program.lead}</p>
          <details class="program-points"><summary>演習の内容を見る</summary><ul>{program.points.map((point) => <li>{point}</li>)}</ul></details>
          <a class="program-contact" href={`/contact/?kind=training&topic=${program.id}`} data-place="training-program">この研修を相談する <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
  <aside class="nearby-evidence rv" id="engagements" aria-label="研修の実績">
    <h3>これまでの研修・ワークショップ実績</h3>
    <p>実際に担当した企業研修・ワークショップの一例です。社名を伏せて掲載しています。</p>
    <ul>{PRIVATE_ENGAGEMENTS.slice(0, 3).map(e => <li><b>{e.sector}</b><span>{e.title}</span></li>)}</ul>
  </aside>
  <ServiceDetails item={training} />
</section>

<section class="band band--paper" id="advisory" data-rail="顧問・アドバイザー">
  <div class="wrap">
    <p class="label rv">Advisory ／ 顧問・アドバイザー</p>
    <h2 class="h2 rv">経営の判断から、<br />組織への浸透まで。</h2>
    <p class="lede rv">{advisory.lede}</p>
    <div class="advisory-areas">
      {ADVISORY_AREAS.map((area, i) => <article class="advisory-area rv" id={area.id}>
        <p class="program-number">{String(i + 1).padStart(2, '0')}</p>
        <h3>{area.title}</h3><p>{area.body}</p>
        <ul>{area.points.map(point => <li>{point}</li>)}</ul>
      </article>)}
    </div>
    <p class="track-note rv">「{ORGANIZATION_CHALLENGES.map(challenge => challenge.title).join('」「')}」といった課題からご相談いただけます。</p>
    <aside class="nearby-evidence rv" id="advisory-evidence" aria-label="全社推進の実績">
      <h3>これまでのAI活用浸透の支援実績</h3>
      <ul>{PRIVATE_ENGAGEMENTS.slice(3).map(e => <li><b>{e.sector}</b><span>{e.title}</span></li>)}</ul>
      <p>実際に関わった取り組みの一例です。社名を伏せて掲載しています。</p>
    </aside>
    <details class="public-track rv">
      <summary>公開している顧問・アドバイザー等の活動先</summary>
      <ul class="track-l">{advisoryTrack.items.map(item => <li>{item}</li>)}</ul>
      <p class="track-note">役職の正式表記は<a href="/about/#positions">プロフィールの役職一覧</a>をご覧ください。</p>
    </details>
    <ServiceDetails item={advisory} />
  </div>
</section>

<section class="band wrap" id="track" data-rail="登壇先">
  <p class="label rv">Track Record</p>
  <h2 class="h2 rv">これまでの登壇先</h2>
  <p class="lede rv">カンファレンスや企業・行政での登壇先をまとめています。個別の活動は<a href="/news/">お知らせ</a>でご覧いただけます。</p>
  <details class="public-track rv">
    <summary>登壇先を一覧で見る</summary>
    <div class="track">
      {speakingTrack.map((group) => <div class="track-g"><h3 class="track-k">{group.label}</h3><ul class="track-l">{group.items.map((item) => <li>{item}</li>)}</ul></div>)}
    </div>
  </details>

</section>

<section class="band wrap" id="process" data-rail="依頼の流れ">
  <p class="label rv">How It Works</p>
  <h2 class="h2 rv">ご相談から契約まで</h2>
  <div class="steps steps--dark stg">
    {steps.map((step) => <div class="step-d"><p class="step-n">{step.n}</p><h3 class="step-h">{step.h}</h3><p class="step-p">{step.p}</p></div>)}
  </div>
</section>

<section class="band band--paper" id="conditions" data-rail="費用・条件">
  <div class="wrap">
    <p class="label rv">FAQ</p>
    <h2 class="h2 rv">費用・ご依頼の条件</h2>
    <div class="faq stg">{FAQ.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
  </div>
</section>

<section class="contact wrap" data-rail="依頼する">
  <p class="label rv">Contact</p>
  <h2 class="contact-h rv">ご依頼・ご相談</h2>
  <p class="lede rv">目的・対象者・想定人数・日程や期間をお知らせいただけると、可否と概算をお返ししやすくなります。企画が固まっていない段階のご相談も歓迎です。</p>
  <div class="contact-grid stg">
    <a class="cc" href="/contact/"><span class="cc-k">Form</span><span class="cc-v">お問い合わせフォーム</span><span class="cc-n">通常2〜3営業日以内に返信します。</span></a>
    <a class="cc" href={`mailto:${SITE.email}`}><span class="cc-k">Mail</span><span class="cc-v">{SITE.email}</span><span class="cc-n">直接メールでも構いません。</span></a>
    <a class="cc" href="/press/"><span class="cc-k">Press Kit</span><span class="cc-v">告知用の素材</span><span class="cc-n">プロフィール文と顔写真はこちら。</span></a>
  </div>
</section>
</Base>

<style>
  .h2{text-wrap:balance}.phrase{display:inline-block}
  .service-byline{color:var(--fg-mid);font-size:clamp(.8rem,1.5vw,1rem);margin-top:1.5rem}
  .format-nav{scroll-margin-top:6rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-block:1px solid var(--rule);margin-top:3rem}
  .format-nav>a{display:flex;flex-direction:column;gap:.55rem;padding:1.6rem 1.2rem;transition:background .25s}
  .format-nav>a+a{border-left:1px solid var(--rule)}
  .format-nav>a:hover{background:rgba(150,180,220,.07)}
  .format-number{display:flex;justify-content:space-between;font-family:var(--f-en);font-size:.78rem;color:var(--fg-mute);margin-bottom:.4rem}
  .format-nav strong{font-size:1rem;font-weight:500}
  .format-purpose{font-family:var(--f-mincho);font-size:.86rem}
  .format-detail{font-size:.875rem;color:var(--fg-mid);line-height:1.8}
  .format-nav a:focus-visible,summary:focus-visible{outline:2px solid currentColor;outline-offset:4px}
  .training-programs{margin-top:3rem}
  .training-program{display:grid;grid-template-columns:3rem 1fr;gap:1.4rem;border-top:1px solid var(--rule);padding:2rem 0}
  .training-program h3,.advisory-area h3{font-family:var(--f-mincho);font-weight:500;line-height:1.65;text-wrap:pretty;font-size:clamp(1.1rem,2.2vw,1.55rem);overflow-wrap:anywhere}
  .program-number{font-family:var(--f-en);font-size:1.3rem;line-height:1.5;color:var(--fg-mute)}
  .program-audience{font-size:.875rem;color:var(--fg-mid);margin-top:.5rem}
  .program-lead{font-size:.92rem;line-height:2;max-width:55em;margin-top:1rem}
  .training-program ul{font-size:.84rem;color:var(--fg-mid);padding-left:1.2rem;line-height:1.95;margin-top:1rem}
  .advisory-areas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 3rem;margin-top:2.5rem}
  .advisory-area{padding:1.8rem 0;border-top:1px solid var(--paper-rule)}
  .advisory-area .program-number{color:var(--paper-mute);margin-bottom:.7rem}
  .advisory-area h3{font-size:1.35rem}
  .advisory-area h3+p,.advisory-area ul{font-size:.9rem;color:var(--paper-mute);line-height:1.95;margin-top:.7rem}
  .advisory-area ul{padding-left:1.2rem}
  #advisory .public-track{border-color:var(--paper-rule)}
  #advisory .public-track>.track-l{margin-block:0 1.2rem}
  #advisory .public-track>.track-note{margin-bottom:1.2rem}
  .public-track{margin-top:2rem;border-block:1px solid var(--rule)}
  .public-track summary{cursor:pointer;padding:1.2rem 0;font-size:.95rem}
  .public-track .track{margin:0 0 1.5rem}
  #track .lede a{border-bottom:1px solid var(--rule)}
  .anchor-alias{display:block;scroll-margin-top:6rem}
  @media(max-width:760px){.format-nav{grid-template-columns:1fr}.format-nav>a+a{border-left:0;border-top:1px solid var(--rule)}}
  @media(max-width:600px){
    .format-nav>a{padding:1rem .7rem}
    .format-number{margin:0}.format-nav strong{font-size:1.1rem}.format-purpose{font-size:.92rem}
    .training-program{grid-template-columns:1fr;gap:.6rem}.advisory-areas{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){.format-nav>a{transition:none}}
</style>
