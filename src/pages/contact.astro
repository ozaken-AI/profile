---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { CONTACT_KINDS, CONTACT_TOPICS, CONTACT_FIELDS } from '../lib/contact.js';
const limit = (key: string) => CONTACT_FIELDS.find(f => f.key === key)!.max;

const title = 'お問い合わせ | 小澤健祐（おざけん）';
const description =
  '基調講演、Gemini・Copilot研修、組織変革・AI活用浸透、顧問、執筆・取材のご相談。内容や時期が未定でも構いません。費用は個別見積もり、通常2〜3営業日以内に返信します。';
---
<Base {title} {description} railInitial="お問い合わせ">

<section class="phead wrap" data-rail="お問い合わせ">
  <div class="phead-glow" aria-hidden="true"></div>
  <p class="label rv">Contact</p>
  <h1 class="phead-h1 rv rv-d1">お問い合わせ</h1>
  <p class="phead-lede rv rv-d2">
    いまの課題や、ご相談の目的をお知らせください。
    費用は個別見積もりです。企画が固まっていない段階のご相談も歓迎です。
  </p>
</section>

<section class="band wrap" style="padding-top:0" data-rail="フォーム">
  <form class="form rv" id="contact-form" method="post" action="/api/contact" novalidate>
    <noscript>
      <p class="form-foot">フォームの利用にはJavaScriptが必要です。<a href={`mailto:${SITE.email}`}>{SITE.email}</a> までメールでご連絡ください。</p>
      <style>.form-grid,.form-hp,.form-actions{display:none!important}</style>
    </noscript>
    <p class="form-required-note">必須はお名前・メールアドレス・ご相談内容の3項目です。</p>
    <div class="form-grid">
      <div class="form-field">
        <label for="cf-name">お名前<span class="req">*</span></label>
        <input type="text" id="cf-name" name="name" maxlength={limit('name')} autocomplete="name" required placeholder="小澤 健祐" />
      </div>
      <div class="form-field">
        <label for="cf-company">会社・団体名</label>
        <input type="text" id="cf-company" name="company" maxlength={limit('company')} autocomplete="organization" placeholder="株式会社◯◯" />
      </div>
      <div class="form-field">
        <label for="cf-email">メールアドレス<span class="req">*</span></label>
        <input type="email" id="cf-email" name="email" maxlength={limit('email')} autocomplete="email" required placeholder="you@example.com" />
      </div>
      <div class="form-field">
        <label for="cf-tel">電話番号</label>
        <input type="tel" id="cf-tel" name="tel" maxlength={limit('tel')} autocomplete="tel" placeholder="03-0000-0000" />
      </div>
      <div class="form-field">
        <label for="cf-kind">ご依頼の種類</label>
        <select id="cf-kind" name="kind">
          {CONTACT_KINDS.map(kind => <option value={kind.label} data-kind={kind.id}>{kind.label}</option>)}
        </select>
      </div>
      <div class="form-field" id="topic-field" hidden>
        <label for="cf-topic">テーマ・研修（任意）</label>
        <select id="cf-topic" name="topic"><option value="">まだ決まっていない</option>{CONTACT_TOPICS.map(topic => <option value={topic.id} data-kind={topic.kind}>{topic.label}</option>)}</select>
      </div>
      <div class="form-field">
        <label for="cf-date" id="date-label">希望する時期</label>
        <input type="text" id="cf-date" name="date" maxlength={limit('date')} placeholder="2026年11月中旬 / 未定" />
      </div>
      <div class="form-field wide">
        <label for="cf-audience" id="audience-label">対象となる方・部門</label>
        <input type="text" id="cf-audience" name="audience" maxlength={limit('audience')} placeholder="分かる範囲でお知らせください" />
      </div>
      <div class="form-field wide">
        <label for="cf-message">ご相談内容<span class="req">*</span></label>
        <textarea id="cf-message" name="message" maxlength={limit('message')} required aria-describedby="message-help" placeholder={CONTACT_KINDS[0].placeholder}></textarea>
        <p class="field-help" id="message-help">8,000文字以内。分かる範囲で構いません。</p>
      </div>
    </div>

    <div class="form-hp" aria-hidden="true">
      <label for="cf-url">この欄は入力しないでください</label>
      <input type="text" id="cf-url" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-actions">
      <button type="submit" class="form-submit" id="cf-submit">送信する</button>
      <p class="form-msg" id="cf-msg" role="status" aria-live="polite"></p>
    </div>

    <p class="form-foot">
      いただいた内容は、ご相談への回答以外の目的では利用しません（<a href="/privacy/">取り扱いについて</a>）。通常2〜3営業日以内にご返信します。
      お急ぎの場合は <a href={`mailto:${SITE.email}`}>{SITE.email}</a> まで直接ご連絡ください。
      告知ページ用のプロフィール文と顔写真は <a href="/press/">プレスキット</a> にあります。
    </p>
  </form>
</section>

<script>
  import { CONTACT_FIELDS, contactKind, contactTopic } from '../lib/contact.js';
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const msg = document.getElementById('cf-msg')!;
    const submit = document.querySelector<HTMLButtonElement>('#cf-submit')!;
    const kindField = document.querySelector<HTMLSelectElement>('#cf-kind')!;
    const topicField = document.querySelector<HTMLSelectElement>('#cf-topic')!;
    const messageField = document.querySelector<HTMLTextAreaElement>('#cf-message')!;
    const fields = CONTACT_FIELDS;
    const field = (key: string) => form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    let openedAt = Date.now(), started = false;
    const requested = new URLSearchParams(location.search);
    kindField.value = contactKind(requested.get('kind')).label;
    const syncKind = () => {
      const kind = contactKind(kindField.value);
      document.getElementById('date-label')!.textContent = kind.date;
      document.getElementById('audience-label')!.textContent = kind.audience;
      messageField.placeholder = kind.placeholder;
      topicField.querySelectorAll<HTMLOptionElement>('option[data-kind]').forEach(option => {
        option.hidden = option.disabled = option.dataset.kind !== kind.id;
      });
      if (!contactTopic(topicField.value, kind.id)) topicField.value = '';
      document.getElementById('topic-field')!.hidden = !['keynote', 'training'].includes(kind.id);
    };
    syncKind();
    const topic = contactTopic(requested.get('topic'), contactKind(kindField.value).id);
    if (topic) topicField.value = topic.id;
    kindField.addEventListener('change', syncKind);
    const tracking = () => ({ kind: contactKind(kindField.value).id, topic: contactTopic(topicField.value, contactKind(kindField.value).id)?.id || 'unspecified' });
    const track = (name: string, extra: Record<string, string> = {}) => (window as any).ozTrack?.(name, { ...tracking(), ...extra });
    const setMsg = (text: string, kind = '') => { msg.className = 'form-msg ' + kind; msg.textContent = text; };
    const clearError = (element: HTMLElement) => {
      element.removeAttribute('aria-invalid');
      const described = element.getAttribute('aria-describedby')?.split(' ').filter(id => id !== 'cf-msg').join(' ');
      if (described) element.setAttribute('aria-describedby', described); else element.removeAttribute('aria-describedby');
    };
    form.addEventListener('input', event => {
      if (event.target instanceof HTMLElement) clearError(event.target);
      if (!started) { started = true; track('contact_start'); }
    });
    form.addEventListener('change', () => { if (!started) { started = true; track('contact_start'); } });
    const invalid = (data: Record<string, string>) => {
      for (const f of fields) if (data[f.key].length > f.max) return [f.key, `${f.label}は${f.max}文字以内で入力してください。`];
      if (!data.name.trim()) return ['name', 'お名前を入力してください。'];
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(data.email.trim())) return ['email', 'メールアドレスの形式を確認してください。'];
      if (!data.message.trim()) return ['message', 'ご相談内容を入力してください。'];
    };
    const showError = (key: string, text: string) => {
      setMsg(text, 'err');
      const input = field(key);
      if (input) {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', [input.getAttribute('aria-describedby'), 'cf-msg'].filter(Boolean).join(' '));
        input.focus();
      }
    };
    const mailtoFallback = (data: Record<string, string>, reason: string) => {
      const kind = contactKind(data.kind);
      const lines = fields.map(f => `${f.key === 'date' ? kind.date : f.key === 'audience' ? kind.audience : f.label}：${f.key === 'topic' ? contactTopic(data.topic, kind.id)?.label || '未定' : data[f.key] || '（未入力）'}`);
      const mail = form.querySelector<HTMLAnchorElement>('.form-foot a[href^="mailto:"]')!.href;
      const href = `${mail}?subject=${encodeURIComponent(`【お問い合わせ】${data.kind}／${data.name}`)}&body=${encodeURIComponent(lines.join('\n'))}`;
      setMsg(reason + '入力内容を保持しています。メールで送る場合は、次のリンクからメールソフトを開いてください。', 'err');
      const link = document.createElement('a'); link.href = href; link.textContent = '入力内容をメールで送る'; msg.append(' ', link);
    };
    form.addEventListener('submit', async event => {
      event.preventDefault();
      fields.forEach(f => clearError(field(f.key)));
      const data: Record<string, string> = Object.fromEntries(fields.map(f => [f.key, field(f.key).value]));
      const bad = invalid(data);
      if (bad) { showError(bad[0], bad[1]); return; }
      submit.disabled = true; setMsg('送信しています…');
      const eventContext = tracking();
      try {
        const response = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, website: field('website').value, elapsed: Date.now() - openedAt }) });
        const body = await response.json();
        if (response.ok && body?.ok === true) {
          (window as any).ozTrack?.('contact_submit', { ...eventContext, result: 'ok' });
          const submittedKind = kindField.value;
          form.reset(); kindField.value = submittedKind; syncKind(); openedAt = Date.now(); started = false;
          setMsg('送信しました。通常2〜3営業日以内にご返信します。', 'ok');
        } else if (body?.configured === false) {
          track('contact_submit', { result: 'メーラーに切替' }); mailtoFallback(data, 'フォーム送信を利用できませんでした。');
        } else {
          track('contact_submit', { result: 'エラー' });
          const error = body?.error || '送信に失敗しました。入力内容は保持しています。時間をおいて再度お試しください。';
          if (fields.some(f => f.key === body.field)) showError(body.field, error); else setMsg(error, 'err');
        }
      } catch {
        track('contact_submit', { result: '通信失敗' }); mailtoFallback(data, '送信できませんでした。');
      } finally { submit.disabled = false; }
    });
  }
</script>
</Base>
<style>
  .form-required-note,.field-help{font-size:.875rem;color:var(--fg-mid);margin-bottom:1rem}
  .field-help{margin-top:.5rem;margin-bottom:0}
  [aria-invalid='true']{border-color:#e29a8d}
  .form-field[hidden]{display:none}
  .form-msg a{display:inline-block;text-decoration:underline;text-underline-offset:4px}
</style>
