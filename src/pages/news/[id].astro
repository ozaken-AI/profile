---
import Base from '../../layouts/Base.astro';
import { getNews, formatDate, categoryOf, thumbOf, type NewsItem } from '../../lib/microcms';

export async function getStaticPaths() {
  const items = await getNews();
  // 未設定なら空。設定済みCMSの取得失敗時はgetNewsがthrowし、記事の一斉欠落を防ぐ。
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props { item: NewsItem; }
const { item }: Props = Astro.props;

const cat = categoryOf(item);
const inquiryKind = /研修|ワークショップ/.test(item.title) ? 'training' : cat === '登壇' || cat === 'イベント' ? 'keynote' : cat === 'メディア' ? 'media' : 'other';
const thumb = thumbOf(item);
// OGPはjpgのほうが確実に展開される。取り込み分（webpの静的ファイル）は既定画像に任せる。
const ogImage = item.thumbnail?.url ? `${item.thumbnail.url}?fm=jpg&w=1200` : undefined;
const meta = [
  item.eventName && { k: 'イベント', v: item.eventName },
  item.audience && { k: '対象', v: item.audience },
  item.scale && { k: '規模', v: item.scale },
  item.location && { k: '場所', v: item.location },
].filter(Boolean) as { k: string; v: string }[];

// 抜粋は本文の書き出しから作ってあることが多い。詳細ページで同じ文が二度続かないようにする。
const lead = item.excerpt?.trim() ?? '';
const showLead = lead.length > 0 && !item.body?.trim();

const title = `${item.title} | 小澤健祐（おざけん）`;
const description =
  lead ||
  `${formatDate(item.publishedDate)}｜${cat}。${item.eventName ?? ''} 小澤健祐（おざけん）のお知らせ。`;

// 検索から直接入ってくるのは、いまのところ記事ページが多い。
// 記事であること・書いた人・日付を機械に読める形で置き、パンくずも添える。
const base = new URL('/', Astro.site).href.replace(/\/$/, '');
const here = `${base}/news/${item.id}/`;
const author = { '@type': 'Person', name: '小澤健祐', alternateName: 'おざけん', url: base };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: item.title,
    description,
    datePublished: item.publishedDate,
    author,
    publisher: author,
    mainEntityOfPage: here,
    ...(item.thumbnail?.url ? { image: `${item.thumbnail.url}?fm=jpg&w=1200` } : {}),
    ...(item.eventName ? { about: item.eventName } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: 'お知らせ', item: `${base}/news/` },
      { '@type': 'ListItem', position: 3, name: item.title, item: here },
    ],
  },
];
---
<Base
  {title} {description} {jsonLd} {...(ogImage ? { ogImage } : {})}
  ogType="article" publishedTime={item.publishedDate}
  railInitial={cat}
>

<article class="post" data-rail={cat}>
  <div class="wrap">
    <div class="post-head rv">
      <p class="post-meta">
        <span class="news-cat">{cat}</span>
        <time datetime={item.publishedDate}>{formatDate(item.publishedDate)}</time>
      </p>
      <h1 class="post-h1">{item.title}</h1>
      {showLead && <p class="post-excerpt">{lead}</p>}
    </div>

    {thumb && (
      <figure class="post-thumb rv rv-d1">
        <img
          src={thumb.src}
          srcset={thumb.srcset}
          sizes="(max-width:900px) 100vw, 900px"
          width={thumb.width} height={thumb.height}
          alt="" loading="eager" decoding="async"
        />
      </figure>
    )}

    {meta.length > 0 && (
      <dl class="post-facts rv rv-d1">
        {meta.map((m) => (<><dt>{m.k}</dt><dd>{m.v}</dd></>))}
      </dl>
    )}

    {item.body && <div class="post-body rv rv-d2" set:html={item.body} />}

    <aside class="post-next rv" aria-label="関連するご依頼">
      <h2>{cat === '登壇' || cat === 'イベント' ? '次の講演・研修を企画する方へ' : '執筆・取材・企業でのAI活用のご相談'}</h2>
      <p>{cat === '登壇' || cat === 'イベント' ? '経営論・組織論・AIエージェントの最新技術トレンドから、業務で使うための研修まで。目的と参加者に合わせて構成します。' : '執筆・監修、取材・メディア出演から、講演・研修・組織変革まで。ご相談の目的をお知らせください。'}</p>
      <div><a href="/speaking/">講演・研修・支援内容を見る →</a><a href={`/contact/?kind=${inquiryKind}`} data-place="news-article">ご依頼を相談する →</a></div>
    </aside>
    <p class="post-back rv rv-d2"><a class="more" href="/news/">お知らせ一覧に戻る <span>→</span></a></p>
  </div>
</article>

</Base>

<style>
  .post-next{margin-top:3rem;padding:1.8rem;border:1px solid var(--rule)}
  h2{font-family:var(--f-mincho);font-size:1.35rem;line-height:1.6;font-weight:500}
  .post-next p{font-size:.95rem;color:var(--fg-mid);line-height:1.9;margin:.8rem 0 1rem}
  .post-next div{display:flex;gap:1rem 2rem;flex-wrap:wrap}
  .post-next a{font-size:.9rem;text-decoration:underline;text-underline-offset:5px;padding:.4rem 0}
</style>
