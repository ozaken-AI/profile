---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import HeroDust from '../components/HeroDust.astro';
import SiteEntrance from '../components/SiteEntrance.astro';
import SpeakingFocus from '../components/SpeakingFocus.astro';
import { getNews } from '../lib/microcms';
import { SITE, NUMBERS, ROLES, FORMATS, speakingHref } from '../lib/site';

import venue from '../assets/photos/venue.jpg';
import portrait from '../assets/photos/portrait.jpg';
import heroPhoto from '../assets/photos/speaking-closeup.jpg';
import lineQr from '../assets/line-qr.svg?raw';

const news = (await getNews(8)).slice(0, 8);

// 実績の数字は、ビルド時に「桁の帯」へ分解する。0〜9を2周ぶん並べた帯を狙いの桁まで
// 送って止めるので、走っている最中も本物の字形が出る。textContent を書き換える方式だと、
// 等幅にしていても桁の増減で幅が跳ねる。
const STRIP = Array.from({ length: 20 }, (_, i) => i % 10);
const fmt = (v: number, comma: boolean) => (comma ? v.toLocaleString('en-US') : String(v));

const title = '小澤健祐（おざけん）｜生成AIの講演・研修・顧問';
const description =
  '小澤健祐（おざけん）の公式サイト。生成AIの講演、Gemini・Microsoft 365 Copilot研修、AI戦略・組織変革の顧問・アドバイザー。経営論・組織論・AIエージェントの最新技術から全社への活用浸透まで。テーマ・実績・相談方法をご案内します。';
---
<Base {title} {description} railInitial="小澤健祐">

<!-- ============ HERO：宣言を先に読み、人物と依頼導線へ ============ -->
<section class="hero wrap" id="s-hero" data-rail="小澤健祐">
  <!-- 人物のまわりに、床あかりとゆっくり舞う粒子を重ねる -->
  <div class="hero-fx" aria-hidden="true">
    <div class="hero-actor">
      <Image
        src={heroPhoto} alt=""
        width={1800} widths={[700, 1000, 1400, 1800, 2200]} quality={82}
        sizes="max(64vw, 150svh)"
        loading="eager" fetchpriority="high" class="hero-actor-img"
      />
    </div>
    <div class="spot-pool"></div>
    <HeroDust />
  </div>
  <SiteEntrance />

  <div class="hero-inner">
    <div class="hero-stage">
      <div class="hero-eyebrow">
        <p class="hero-name">{SITE.name}</p>
        <p class="hero-primary-role">{SITE.role}</p>
      </div>

      <div class="hero-h1wrap">
        <h1 class="hero-h1">
          <span class="line l1"><span class="ln">人間とAIが</span></span>
          <span class="line l2"><span class="ln"><em>共存する社会</em>を</span></span>
          <span class="line l3"><span class="ln">つくる。</span></span>
        </h1>
      </div>

      <p class="hero-sub">
        経営論・組織論・AIエージェントの最新技術を、<br />
        <b>講演から研修、全社への活用浸透まで。</b>
      </p>

      <div class="hero-actions">
        <a class="hero-cta" href="/contact/" data-place="hero">ご依頼・ご相談 <span aria-hidden="true">→</span></a>
        <a class="hero-link" href="/speaking/">講演・研修・支援内容を見る</a>
      </div>
    </div>

    <!-- 右端の縦組みミッション。写真の暗部の上に置く -->
    <div class="hero-vert" aria-hidden="true">
      <span class="en">Mission</span>
      <span class="vert-mission">{SITE.mission}</span>
    </div>
  </div>

  <div class="hero-foot">
    <a class="hero-continuation" href="#s-news" aria-label="お知らせへ進む" title="お知らせへ進む">
      <svg viewBox="0 0 80 52" aria-hidden="true" focusable="false">
        <path class="continuation-seam continuation-seam--left" d="M6 17H31M31 13V21" />
        <path class="continuation-seam continuation-seam--right" d="M49 13V21M49 17H74" />
        <path class="continuation-trace" d="M40 15V42" />
        <circle class="continuation-origin" cx="40" cy="17" r="1.7" />
        <circle class="continuation-particle" cx="40" cy="17" r="1.5" />
        <circle class="continuation-particle continuation-particle--left" cx="40" cy="17" r=".8" />
        <circle class="continuation-particle continuation-particle--right" cx="40" cy="17" r=".8" />
      </svg>
    </a>
    <nav class="hero-jumps" aria-label="目的に合う依頼内容へ">
      {FORMATS.map((format) => <a href={speakingHref(format.slug)}>{format.shortLabel}<span aria-hidden="true">↗</span></a>)}
    </nav>
  </div>
</section>

<!-- ============ NEWS ============ -->
<section class="band wrap" id="s-news" data-rail="お知らせ">
  <p class="label rv">News</p>
  <h2 class="h2 rv rv-d1">お知らせ</h2>
  <p class="lede rv rv-d2">カンファレンスや企業・団体での登壇、メディア出演、リリースなど、日々の活動を更新しています。</p>
  <div class="rv rv-d2"><NewsList items={news} /></div>
  <a class="more" href="/news/">お知らせ一覧 <span>→</span></a>
</section>

<SpeakingFocus />

<!-- ============ NUMBERS ============ -->
<section id="s-num" data-rail="実績の輪郭">
  <div class="nums-wrap">
    <Image
      src={venue} alt="" aria-hidden="true"
      width={4000} widths={[1200, 2000, 2800, 4000]} quality={78} sizes="100vw" loading="lazy" class="nums-img"
    />
    <div class="nums">
      {NUMBERS.map((n) => (
        <div class="num">
          <div class="num-v">
            <span class="odo">
              <span class="a11y">{fmt(n.value, n.comma)}</span>
              {fmt(n.value, n.comma).split('').map((ch, i) => (ch === ','
                ? <b class="odo-sep" aria-hidden="true">,</b>
                : <span class="odo-col" aria-hidden="true"><i style={`--n:${10 + Number(ch)};--i:${i}`}>{STRIP.map((d) => <b>{d}</b>)}</i></span>
              ))}
            </span>
            <small>{n.unit}</small>
          </div>
          <p class="num-k">{n.key}</p>
          <p class="num-n">{n.note[0]}<br />{n.note[1]}</p>
          {n.source && <a class="num-source" href={n.source} target="_blank" rel="noopener noreferrer">公開情報 ↗</a>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ PROFILE（紙の面） ============ -->
<section class="band band--paper" id="s-profile" data-rail="人物">
  <div class="wrap">
    <p class="label rv">Profile</p>
    <div class="profile-grid">
      <p class="profile-vert rv">目指してきたのは、<br />分断をこえること</p>
      <div class="profile-body rv rv-d1">
        <p>AI専門メディア「AINOW」編集長を経て、事業会社の経営、企業への助言、AICX協会での活動へ。取材と実践で得た知見を、事業・組織・人材を考えるための視点として届けます。</p>

        <div class="shots">
          <div class="photo-frame photo-frame--tall">
            <Image src={portrait} alt="小澤健祐" width={1600} widths={[420, 840, 1200, 1600]} quality={84} sizes="(max-width:600px) 100vw, 30vw" class="shot shot--tall" />
          </div>

        </div>

        <div class="credits stg">
          {ROLES.slice(0, 6).map((r) => (
            <div class="credit"><b>{r.org}</b><span>{r.title}</span></div>
          ))}
        </div>
        <p class="credits-etc">ほか、著書・活動歴・役職はプロフィールにまとめています。</p>
        <a class="more" href="/about/">著書・詳しい経歴 <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- ============ RESOURCES ============ -->
<section class="band wrap" id="s-resources" data-rail="動画と資料">
  <p class="label rv">Resources</p>
  <h2 class="h2 rv rv-d1">AIの実践を、<br />動画と資料で。</h2>

  <div class="res-grid">
    <a class="res res--video rv rv-d2" href={SITE.youtube} target="_blank" rel="noopener noreferrer">
      <p class="res-kicker">
        <svg class="res-play" width="28" height="20" viewBox="0 0 28 20" aria-hidden="true" focusable="false">
          <rect width="28" height="20" rx="5" fill="currentColor" />
          <path d="m11 5 8 5-8 5Z" fill="#fff" />
        </svg>
        YouTube
      </p>
      <div>
        <h3 class="res-title">{SITE.youtubeName}</h3>
        <p class="res-p">生成AIの使い方から企業での活用まで。現場での実践や気づきを、対談と解説でお届けします。</p>
        <div class="res-tags">
          <span class="res-tag">AI活用の解説</span>
          <span class="res-tag">現場レポート</span>
          <span class="res-tag">AIエージェント</span>
        </div>
      </div>
      <div class="res-footer">
        <span class="res-action">YouTubeで見る</span>
        <span class="res-go" aria-hidden="true">↗</span>
      </div>
    </a>

    <a class="res rv rv-d3" href={SITE.contentSite} target="_blank" rel="noopener noreferrer">
      <p class="res-kicker">content.ozaken.ai</p>
      <div>
        <h3 class="res-title">コンテンツ一覧</h3>
        <p class="res-p">AIエージェントの活用、業務変革、人材育成などの資料・解説をまとめています。一部を無料でご覧いただけます。</p>
        <div class="res-tags">
          <span class="res-tag">AIエージェント</span>
          <span class="res-tag">業務変革</span>
          <span class="res-tag">人材育成</span>
        </div>
      </div>
      <div class="res-footer">
        <span class="res-action">コンテンツ一覧を見る</span>
        <span class="res-go" aria-hidden="true">↗</span>
      </div>
    </a>
  </div>

</section>

<!-- ============ CONTACT ============ -->
<section class="contact wrap" id="s-contact" data-rail="連絡先">
  <p class="label rv">Contact</p>
  <h2 class="contact-h rv rv-d1">ご依頼・ご相談</h2>
  <p class="lede rv">費用は個別見積もりです。課題や目的から、関わり方をご相談いただけます。内容や時期が未定でも構いません。</p>
  <p class="contact-guide rv"><a href="/speaking/#conditions">費用・条件</a><a href="/speaking/#process">ご相談から契約まで</a></p>

  <div class="contact-grid stg">
    <a class="cc" href="/contact/">
      <span class="cc-k">Form</span>
      <span class="cc-v">お問い合わせフォーム</span>
      <span class="cc-n">ご相談の目的と、分かる範囲の条件をお知らせください。通常2〜3営業日以内に返信します。</span>
    </a>
    <a class="cc" href={`mailto:${SITE.email}`}>
      <span class="cc-k">Mail</span>
      <span class="cc-v">{SITE.email}</span>
      <span class="cc-n">直接メールでも構いません。</span>
    </a>
    <a class="cc" href={SITE.x} target="_blank" rel="noopener noreferrer">
      <span class="cc-k">X</span>
      <span class="cc-v">{SITE.xHandle}</span>
      <span class="cc-n">日々のAIの動きはこちらで発信しています。</span>
    </a>
    <a class="cc" href="/press/">
      <span class="cc-k">Press Kit</span>
      <span class="cc-v">プロフィール・顔写真</span>
      <span class="cc-n">告知ページ用の素材一式。プロフィール文は長短2種を用意。</span>
    </a>
  </div>

</section>

<!-- ============ 隠しコマンド（LINE） ============
     ファーストビューを上から順に 名前 → 見出し → 光の合図 と3回たたくと開く。
     PCでは ozaken とタイプしても開く。ナビからは辿れない。面は墨で統一。 -->
<dialog class="lpanel" id="linePanel" aria-labelledby="lpanelTitle">
  <div class="lpanel-scrim" data-lp-close></div>
  <div class="lpanel-card" tabindex="-1">
    <button class="lpanel-x" type="button" data-lp-close aria-label="閉じる">×</button>
    <div class="lpanel-seal" aria-hidden="true"></div>
    <p class="lpanel-eyebrow">Access granted</p>
    <h2 class="lpanel-h" id="lpanelTitle">LINEでつながる</h2>
    <p class="lpanel-p">見つけていただき、ありがとうございます。<br />ここからなら直接ご連絡いただけます。</p>
    <div class="lpanel-qr" aria-hidden="true" set:html={lineQr}></div>
    <a class="lpanel-btn" href={SITE.line} target="_blank" rel="noopener noreferrer">友だち追加 <span aria-hidden="true">→</span></a>
    <button class="lpanel-copy" type="button" id="lpanelCopy">リンクをコピー</button>
  </div>
</dialog>

<script is:inline define:vars={{ LINE_URL: SITE.line }}>
  (() => {
    const panel = document.getElementById('linePanel');
    if (!panel) return;
    const card = panel.querySelector('.lpanel-card');
    let last = null;

    function open() {
      if (panel.open) return;
      last = document.activeElement;
      panel.showModal();
      requestAnimationFrame(() => panel.classList.add('on'));
      document.documentElement.style.overflow = 'hidden';
      card?.focus();
    }
    function close() {
      if (!panel.open) return;
      panel.classList.remove('on');
      document.documentElement.style.overflow = '';
      panel.close();
      if (last instanceof HTMLElement) last.focus();
    }
    panel.querySelectorAll('[data-lp-close]').forEach((b) => b.addEventListener('click', close));
    panel.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    // カードの中のクリックで閉じないようにする
    card?.addEventListener('click', (e) => e.stopPropagation());

    /* リンクをコピー */
    const copy = document.getElementById('lpanelCopy');
    copy?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(LINE_URL); }
      catch {
        const t = document.createElement('textarea');
        t.value = LINE_URL; document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } catch {}
        t.remove();
      }
      const before = copy.textContent;
      copy.textContent = 'コピーしました';
      setTimeout(() => { copy.textContent = before; }, 1600);
    });

    /* 順番にたたく：名前 → 見出し → 光の合図。間違えたら最初から。6秒あいてもリセット。 */
    const SEQ = ['#s-hero .hero-eyebrow', '#s-hero .hero-h1wrap', '#s-hero .hero-continuation'];
    let step = 0;
    let timer = 0;
    const arm = () => { clearTimeout(timer); timer = window.setTimeout(() => { step = 0; }, 6000); };
    SEQ.forEach((sel, i) => {
      const el = document.querySelector(sel);
      if (!el) return;
      if (i < SEQ.length - 1) el.style.cursor = 'default';
      el.addEventListener('click', (event) => {
        if (i !== step) { clearTimeout(timer); step = i === 0 ? 1 : 0; if (step) arm(); return; }
        step += 1;
        // 効いたことが分かるように、朱をひと呼吸だけ差す
        el.classList.remove('secret-hit');
        void el.offsetWidth;
        el.classList.add('secret-hit');
        if (step === SEQ.length) { event.preventDefault(); clearTimeout(timer); step = 0; open(); } else arm();
      });
    });

    /* PCは ozaken とタイプしても開く */
    let buf = '';
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target;
      if (t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      if (e.key.length !== 1) return;
      buf = (buf + e.key.toLowerCase()).slice(-6);
      if (buf === 'ozaken') { buf = ''; open(); }
    });
  })();
</script>
</Base>
