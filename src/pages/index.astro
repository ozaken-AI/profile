---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import NewsList from '../components/NewsList.astro';
import { getNews } from '../lib/microcms';
import { SITE, NUMBERS, ROLES, HERO_ROLES, MENU, STEPS, FAQ, PROFILE } from '../lib/site';
import lineQr from '../assets/line-qr.svg?raw';

import stageWide from '../assets/photos/portrait-full.jpg';
import panel from '../assets/photos/panel.jpg';
import venue from '../assets/photos/venue.jpg';
import portrait from '../assets/photos/portrait.jpg';
import speakingStanding from '../assets/photos/speaking-standing.jpg';
import speakingSeated from '../assets/photos/speaking-seated.jpg';
import heroPhoto from '../assets/photos/speaking-closeup.jpg';

const news = (await getNews(4)).slice(0, 4);

const title = '小澤健祐（おざけん）| 生成AI・AIエージェントの講演・研修・アドバイザリー';
const description =
  '一般社団法人AICX協会 代表理事。年間300回を超える登壇と1,500本超の記事執筆で、生成AIとAIエージェントの導入を、経営の意思決定と現場の実装の両側から支えています。講演・研修・顧問のご依頼はこちら。';
---
<Base {title} {description} railInitial="小澤健祐">

<!-- ============ HERO：開演 ============
     年300回、舞台に立つ人。最初の画面は暗転した劇場として組む。
     スポットライトが1本入り、光の中に人物が浮かび、光に近い行から見出しが確定する。
     開場したあとは、マウスが第2の照明になる。 -->
<section class="hero wrap" id="s-hero" data-rail="小澤健祐">
  <!-- コンテンツ管理システム（content.ozaken.ai）と対になるバッジ。書体と作りを揃える -->
  <p class="sys-badge"><i aria-hidden="true"></i>おざけん ポートフォリオ管理システム<span>／ OZAKEN.AI V2.0</span></p>

  <!-- 舞台装置。光の錐 → 人物 → 床あかり → 塵 の順に重ねる -->
  <div class="hero-fx" aria-hidden="true">
    <div class="spot-beam"></div>
    <div class="hero-actor">
      <Image
        src={heroPhoto} alt=""
        width={1400} widths={[420, 700, 1000, 1400]} quality={82}
        sizes="(max-width:860px) 100vw, 64vw"
        loading="eager" fetchpriority="high" class="hero-actor-img"
      />
    </div>
    <div class="spot-pool"></div>
    <div class="spot-dust"></div>
  </div>

  <div class="hero-inner">
    <div class="hero-stage">
      <p class="hero-eyebrow">Kensuke Ozawa — Ozaken</p>

      <div class="hero-h1wrap">
        <h1 class="hero-h1" id="heroH1">
          <span class="line l1"><span class="ln">人間とAIが</span></span>
          <span class="line l2"><span class="ln"><em>共存する社会</em>を</span></span>
          <span class="line l3"><span class="ln">つくる<a
            class="hero-dot" id="heroDot" href={SITE.line} data-place="見出しの句点"
            target="_blank" rel="noopener noreferrer"
            aria-label="LINEで小澤健祐に直接連絡する">。</a></span></span>
        </h1>
      </div>

      <p class="hero-sub">
        <span>技術のことばを、<b>経営の意思決定</b>に。</span>
        <span>経営のことばを、<b>現場の手順</b>に。</span>
      </p>
    </div>
  </div>

  <!-- マウスに追従する第2の照明。文字も写真も、なでた場所がほのかに明るくなる -->
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-foot">
    <div class="scrollcue"><i></i>Scroll</div>
    <p class="hero-role" id="heroRole" aria-hidden="true">
      {HERO_ROLES.map((r, i) => (
        <span class:list={['hero-role-i', { on: i === 0 }]}>{r}</span>
      ))}
    </p>
  </div>
</section>

<!-- ============ STAGE：主張の直後に証拠を置く ============ -->
<figure class="stage stage--top" id="s-stage" data-rail="現場">
  <Image
    src={stageWide} alt="登壇する小澤健祐"
    width={4000} widths={[1200, 1800, 2600, 3400, 4000]} quality={84}
    sizes="100vw" loading="eager" fetchpriority="high" class="stage-img"
  />
  <figcaption class="stage-cap">
    <div class="stage-cap-inner">
      <p>今日も、どこかで話している。</p>
      <span>Speaking · 300+ times a year</span>
    </div>
  </figcaption>
</figure>

<Ticker />

<!-- ============ NUMBERS ============ -->
<section id="s-num" data-rail="実績の輪郭">
  <div class="nums-wrap">
    <Image
      src={venue} alt="" aria-hidden="true"
      width={4000} widths={[1200, 2000, 2800, 4000]} quality={78} sizes="100vw" loading="lazy" class="nums-img"
    />
    <div class="nums">
      {NUMBERS.map((n) => (
        <div class="num">
          <div class="num-v">
            <span class="cnt" data-to={n.value} data-comma={n.comma ? '1' : '0'}>
              {n.comma ? n.value.toLocaleString('en-US') : n.value}
            </span>
            <small>{n.unit}</small>
          </div>
          <p class="num-k">{n.key}</p>
          <p class="num-n">{n.note[0]}<br />{n.note[1]}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ NEWS ============ -->
<section class="band wrap" id="s-news" data-rail="お知らせ">
  <p class="label rv">News</p>
  <h2 class="h2 rv rv-d1">お知らせ</h2>
  <p class="lede rv rv-d2">登壇の報告、メディア出演、リリースを更新しています。</p>
  <div class="rv rv-d2"><NewsList items={news} /></div>
  <a class="more" href="/news/">お知らせ一覧 <span>→</span></a>
</section>

<!-- ============ PROFILE（紙の面） ============ -->
<section class="band band--paper" id="s-profile" data-rail="人物">
  <div class="wrap">
    <p class="label rv">Profile</p>
    <div class="profile-grid">
      <p class="profile-vert rv">目指してきたのは、<br />分断をこえること</p>
      <div class="profile-body rv rv-d1">
        {PROFILE.map((t) => <p>{t}</p>)}

        <div class="shots">
          <Image src={portrait} alt="小澤健祐" width={1600} widths={[420, 840, 1200, 1600]} quality={84} sizes="(max-width:600px) 100vw, 30vw" class="shot shot--tall" />
          <Image src={panel} alt="対談に登壇する小澤健祐" width={2200} widths={[600, 1200, 1600, 2200]} quality={84} sizes="(max-width:600px) 100vw, 42vw" class="shot shot--wide" />
        </div>

        <div class="credits stg">
          {ROLES.map((r) => (
            <div class="credit"><b>{r.org}</b><span>{r.title}</span></div>
          ))}
        </div>
        <p class="credits-etc">など</p>
        <a class="more" href="/about/">詳しい経歴 <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- ============ SPEAKING ============ -->
<section class="band wrap" id="s-speaking" data-rail="依頼できること">
  <p class="label rv">Speaking</p>
  <h2 class="h2 rv rv-d1">講演・研修・伴走支援・<br />アドバイザリー</h2>
  <p class="lede rv rv-d2">聞き手が誰で、終わったあと何をしていてほしいか。この2つをうかがえると、どんな形がよさそうかをご提案しやすくなります。</p>

  <div class="menu stg">
    {MENU.map((m) => (
      <a class="menu-item" href={`/speaking/${m.slug}/`}>
        <span class="menu-idx">{m.idx}</span>
        <h3 class="menu-h">{m.kind}</h3>
        <p class="menu-sub">{m.title}</p>
        <p class="menu-spec">{m.spec}</p>
        <p class="menu-p">{m.body}</p>
        <p class="menu-for">向いている場：<b>{m.forWhom}</b></p>
        <span class="menu-go">詳しく <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>

  <div class="pair rv rv-d3">
    <Image src={speakingStanding} alt="基調講演で登壇する小澤健祐" width={2000} widths={[560, 1120, 1600, 2000]} quality={84} sizes="(max-width:600px) 100vw, 46vw" class="shotbox" />
    <Image src={speakingSeated} alt="パネルディスカッションに登壇する小澤健祐" width={2000} widths={[560, 1120, 1600, 2000]} quality={84} sizes="(max-width:600px) 100vw, 46vw" class="shotbox" />
  </div>

  <p class="track-note rv rv-d3" style="margin-top:2.2rem">
    AI・人工知能EXPO、日経メッセ、DX総合EXPO、IVS、Startup JAPAN など。
    <a href="/speaking/#track" style="border-bottom:1px solid var(--rule)">登壇実績</a>もまとめています。
  </p>

  <a class="more" href="/speaking/">ご依頼について <span>→</span></a>
</section>

<!-- ============ RESOURCES ============ -->
<section class="band wrap" id="s-resources" data-rail="資料">
  <p class="label rv">Resources</p>
  <h2 class="h2 rv rv-d1">話した内容は、<br />資料としてまとめています。</h2>

  <a class="res rv rv-d2" href={SITE.contentSite} target="_blank" rel="noopener noreferrer">
    <div>
      <p class="res-domain">content.ozaken.ai</p>
      <p class="res-p">講演で使った図解や、導入を検討するときの手順をまとめた資料を置いています。社内での共有にお使いください。</p>
      <div class="res-tags">
        <span class="res-tag">講演スライド</span>
        <span class="res-tag">導入の手順書</span>
        <span class="res-tag">チェックリスト</span>
        <span class="res-tag">図解</span>
      </div>
    </div>
    <div class="res-go" aria-hidden="true">→</div>
  </a>

</section>

<!-- ============ PROCESS + FAQ（紙の面） ============ -->
<section class="band band--paper" id="s-process" data-rail="依頼の流れ">
  <div class="wrap">
    <p class="label rv">How it works</p>
    <h2 class="h2 rv rv-d1">依頼から当日までの流れ</h2>

    <div class="steps stg">
      {STEPS.map((s) => (
        <div class="step">
          <p class="step-n">{s.n}</p>
          <h3 class="step-h">{s.h}</h3>
          <p class="step-p">{s.p}</p>
        </div>
      ))}
    </div>

    <div class="faq stg">
      {FAQ.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section class="contact wrap" id="s-contact" data-rail="連絡先">
  <p class="label rv">Contact</p>
  <h2 class="contact-h rv rv-d1">ご依頼・ご相談</h2>

  <div class="contact-grid stg">
    <a class="cc" href="/contact/">
      <span class="cc-k">Form</span>
      <span class="cc-v">お問い合わせフォーム</span>
      <span class="cc-n">目的・対象者・想定人数・日程を入れて送信。2〜3営業日以内に返信します。</span>
    </a>
    <a class="cc" href={`mailto:${SITE.email}`}>
      <span class="cc-k">Mail</span>
      <span class="cc-v">{SITE.email}</span>
      <span class="cc-n">直接メールでも構いません。</span>
    </a>
    <a class="cc" href={SITE.x} target="_blank" rel="noopener noreferrer">
      <span class="cc-k">X</span>
      <span class="cc-v">{SITE.xHandle}</span>
      <span class="cc-n">日々のAIの動きはこちらで発信しています。</span>
    </a>
    <a class="cc" href="/press/">
      <span class="cc-k">Press Kit</span>
      <span class="cc-v">プロフィール・顔写真</span>
      <span class="cc-n">告知ページ用の素材一式。プロフィール文は長短2種を用意。</span>
    </a>
  </div>

</section>

<!-- ============ 隠しコマンド（LINE） ============
     ファーストビューを上から順に VISION → 見出し → SCROLL と3回たたくと開く。
     PCでは ozaken とタイプしても開く。ナビからは辿れない。 -->
<div class="secret" id="secret" hidden>
  <div class="secret-scrim" data-secret-close></div>
  <div class="secret-card" role="dialog" aria-modal="true" aria-labelledby="secretTitle" tabindex="-1">
    <button class="secret-x" type="button" data-secret-close aria-label="閉じる">×</button>
    <div class="secret-seal" aria-hidden="true">健</div>
    <p class="secret-eyebrow">Hidden</p>
    <h2 class="secret-h" id="secretTitle">LINEでつながる</h2>
    <p class="secret-p">見つけていただき、ありがとうございます。<br />ここからなら直接ご連絡いただけます。</p>
    <div class="secret-qr" aria-hidden="true" set:html={lineQr}></div>
    <a class="secret-btn" href={SITE.line} data-place="隠しコマンドの面" target="_blank" rel="noopener noreferrer">LINEで友だち追加 <span aria-hidden="true">→</span></a>
    <button class="secret-copy" type="button" id="secretCopy">リンクをコピー</button>
  </div>
</div>

<script is:inline define:vars={{ LINE_URL: SITE.line }}>
  (() => {
    const panel = document.getElementById('secret');
    if (!panel) return;
    const card = panel.querySelector('.secret-card');
    let last = null;

    function open() {
      if (!panel.hidden) return;
      last = document.activeElement;
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('on'));
      document.documentElement.style.overflow = 'hidden';
      card?.focus();
      window.ozTrack?.('secret_open', {});
    }
    function close() {
      if (panel.hidden) return;
      panel.classList.remove('on');
      document.documentElement.style.overflow = '';
      setTimeout(() => { panel.hidden = true; }, 320);
      if (last instanceof HTMLElement) last.focus();
    }
    panel.querySelectorAll('[data-secret-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    // カードの中のクリックで閉じないようにする
    card?.addEventListener('click', (e) => e.stopPropagation());

    /* リンクをコピー */
    const copy = document.getElementById('secretCopy');
    copy?.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(LINE_URL); }
      catch { 
        const t = document.createElement('textarea');
        t.value = LINE_URL; document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } catch {}
        t.remove();
      }
      const before = copy.textContent;
      copy.textContent = 'コピーしました';
      setTimeout(() => { copy.textContent = before; }, 1600);
    });

    /* 順番にたたく：名前 → 見出し → SCROLL。間違えたら最初から。6秒あいてもリセット。 */
    const SEQ = ['#s-hero .hero-eyebrow', '#s-hero .hero-h1wrap', '#s-hero .scrollcue'];
    let step = 0;
    let timer = 0;
    const arm = () => { clearTimeout(timer); timer = window.setTimeout(() => { step = 0; }, 6000); };
    // 「。」はLINEへの入口。手数には数えない
    document.getElementById('heroDot')?.addEventListener('click', (e) => e.stopPropagation());
    SEQ.forEach((sel, i) => {
      const el = document.querySelector(sel);
      if (!el) return;
      el.style.cursor = 'default';
      el.addEventListener('click', () => {
        if (i !== step) { clearTimeout(timer); step = i === 0 ? 1 : 0; if (step) arm(); return; }
        step += 1;
        // 効いたことが分かるように、朱をひと呼吸だけ差す
        el.classList.remove('secret-hit');
        void el.offsetWidth;
        el.classList.add('secret-hit');
        if (step === SEQ.length) { clearTimeout(timer); step = 0; open(); } else arm();
      });
    });

    /* PCは ozaken とタイプしても開く */
    let buf = '';
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target;
      if (t instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      if (e.key.length !== 1) return;
      buf = (buf + e.key.toLowerCase()).slice(-6);
      if (buf === 'ozaken') { buf = ''; open(); }
    });
  })();
</script>
</Base>
