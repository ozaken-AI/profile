---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** OGP画像の絶対URL。省略時はサイト共通のもの */
  ogImage?: string;
  /** OGP画像の内容説明。省略時はサイト共通のもの */
  ogImageAlt?: string;
  /** 記事ページは article。省略時は website */
  ogType?: 'website' | 'article';
  /** 記事の公開日時（ISO 8601）。article のときだけ出す */
  publishedTime?: string;
  /** 左レールに出す既定の現在地 */
  railInitial?: string;
}
const {
  title, description, ogImage, ogImageAlt, ogType = 'website', publishedTime,
  railInitial = '現在地',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isTop = Astro.url.pathname === '/';
// 相対パスで渡されても絶対URLにする。第1引数が絶対URLならベースは無視される。
const ogPath = ogImage ?? '/ogp.png';
// SNS側は画像をURL単位で長く持つ。作り直したら OG_VERSION を上げて、取り直させる。
const OG_VERSION = '2';
const isOwnOg = ogPath.startsWith('/ogp');
const og = new URL(isOwnOg ? `${ogPath}?v=${OG_VERSION}` : ogPath, Astro.site).href;
// public/ogp*.png は1200×630で作ってある。
// CMSのサムネイルなど外から来た画像は大きさが分からないので寸法を書かない。
const ogSized = isOwnOg;
const ogAlt = ogImageAlt ?? '小澤健祐（おざけん）｜人間とAIが共存する社会をつくる。';
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og} />
<meta property="og:image:alt" content={ogAlt} />
{ogSized && (
  <>
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.xHandle} />
<meta name="twitter:creator" content={SITE.xHandle} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="theme-color" content="#0A0D13" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Shippori+Mincho+B1:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
<script is:inline>
  /* 2回目以降は幕を出さない。描画より先に決める必要があるのでここに置く。 */
  try { if (sessionStorage.getItem('ozaken:entered')) document.documentElement.dataset.entered = '1'; } catch (e) {}
</script>
<noscript><style>
  /* JSが動かない環境でも、出現アニメーション待ちで中身が消えないようにする */
  .rv,.stg>*{opacity:1!important;transform:none!important}
  .phead-h1,.h2,.contact-h{clip-path:none!important;opacity:1!important}
  .line>span{transform:none!important}
  .hero-media{clip-path:none!important}
  .hero-cut{transform:none!important}
</style></noscript>
</head>
<body>

{isTop && (
  <div class="curtain" id="curtain" aria-hidden="true">
    <div class="curtain-in">
      <div class="curtain-seal"><span>健</span></div>
      <p class="curtain-mark">OZAKEN.AI</p>
      <div class="curtain-bar"><i></i></div>
    </div>
  </div>
)}

<div class="rail" aria-hidden="true">
  <div class="rail-mark">OZAKEN.AI</div>
  <div class="rail-now" id="railNow">{railInitial}</div>
  <div class="rail-prog"><i></i></div>
  <div class="rail-seal">健</div>
</div>

<SiteHeader />

<div class:list={['page', { 'has-head': !isTop }]}>
  <slot />
  <SiteFooter />
</div>

<script>
  /* 出現アニメーション ＋ 左レールの現在地表示 */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 見出しとまとまりも同じ仕組みで出す。取りこぼすと出たまま隠れるので、まとめて拾う。
  const ANIMATED = '.rv, .stg, .h2, .phead-h1, .contact-h';

  try {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); }
      });
      // お知らせ一覧のように画面より背の高い要素は交差比が0.12に届かない。
      // しきい値は0にして、下端の余白で「少し入ったら」を作る。
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll(ANIMATED).forEach((el) => io.observe(el));

    /* 幕が上がるのに合わせて、最初の画面を出す。
       幕は CSS だけで上がるので、JSが動かなくてもページは開く。 */
    const hero = document.querySelector('.hero');
    const curtain = document.getElementById('curtain');
    const showHero = () => hero && hero.classList.add('on');
    const skip = !curtain || reduce || document.documentElement.dataset.entered === '1';
    if (skip) {
      curtain?.remove();
      if (hero) requestAnimationFrame(showHero);
    } else {
      try { sessionStorage.setItem('ozaken:entered', '1'); } catch (e) {}
      // 幕が上がりはじめる時刻。CSS の animation-delay と合わせる。
      setTimeout(showHero, 1150);
      setTimeout(() => curtain.remove(), 2200);
    }
  } catch (e) {
    // 出現の仕掛けが動かなかったときに、中身が隠れたままにならないようにする
    document.querySelectorAll(ANIMATED).forEach((el) => el.classList.add('on'));
    document.querySelector('.hero')?.classList.add('on');
    console.error('[reveal]', e);
  }

  /* 見出しが「確定していく」ように出す。
     文字は最初ランダムに入れ替わり、左から順に本来の字に落ち着く。
     塗りの見出しと輪郭の見出しは同じ文字列を書き込むので、継ぎ目はずれない。 */
  const CJK = '知能情報生成学習演算推論記憶構造意味言語共存社会人間未来創造変革設計実装対話理解';
  const LAT = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const pick = (c: string) =>
    c.charCodeAt(0) < 128 ? LAT[(Math.random() * LAT.length) | 0] : CJK[(Math.random() * CJK.length) | 0];

  function textNodes(root: Element) {
    const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const out: Text[] = [];
    let n: Node | null;
    while ((n = w.nextNode())) out.push(n as Text);
    return out;
  }
  function paint(nodes: Text[], lens: number[], s: string) {
    let k = 0;
    for (let i = 0; i < nodes.length; i++) { nodes[i].nodeValue = s.slice(k, k + lens[i]); k += lens[i]; }
  }

  try {
    const solid = document.getElementById('heroH1');
    const outline = document.getElementById('heroH1o');
    if (solid && !reduce) {
      const gl = outline ? Array.from(outline.querySelectorAll('.ln')) : [];
      const jobs = Array.from(solid.querySelectorAll('.ln')).map((ln, i) => {
        const a = textNodes(ln);
        const b = gl[i] ? textNodes(gl[i]) : [];
        return { i, a, b, lens: a.map((n) => (n.nodeValue || '').length), chars: a.map((n) => n.nodeValue || '').join('').split('') };
      }).filter((j) => j.chars.length);

      if (jobs.length) {
        const t0 = performance.now();
        let lastRoll = 0;
        let cur: string[] = jobs.map(() => '');
        const frame = (t: number) => {
          const el = t - t0;
          const roll = t - lastRoll > 46;
          if (roll) lastRoll = t;
          let pending = false;
          jobs.forEach((j, ji) => {
            let out = '';
            const prev = cur[ji];
            for (let k = 0; k < j.chars.length; k++) {
              // 行ごとに少しずらし、そのなかで1文字ずつ確定させる
              const lock = 300 + j.i * 140 + k * 72;
              if (el >= lock) { out += j.chars[k]; continue; }
              pending = true;
              out += roll || !prev[k] ? pick(j.chars[k]) : prev[k];
            }
            if (out !== prev) {
              cur[ji] = out;
              paint(j.a, j.lens, out);
              if (j.b.length) paint(j.b, j.lens, out);
            }
          });
          if (pending) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    }
  } catch (e) {
    console.error('[scramble]', e);
  }

  /* 数字のカウントアップ */
  function run(el: HTMLElement) {
    const to = Number(el.dataset.to);
    const comma = el.dataset.comma === '1';
    const fmt = (v: number) => (comma ? v.toLocaleString('en-US') : String(v));
    if (reduce) { el.textContent = fmt(to); return; }
    el.textContent = fmt(0);
    let t0: number | null = null;
    const step = (t: number) => {
      if (t0 === null) t0 = t;
      const p = Math.min((t - t0) / 1500, 1);
      el.textContent = fmt(Math.round(to * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  const ioN = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); ioN.unobserve(e.target); } });
  }, { threshold: 0.5 });
  document.querySelectorAll<HTMLElement>('.cnt').forEach((el) => ioN.observe(el));

  /* ヒーローの肩書きを順に入れ替える */
  const roleBox = document.getElementById('heroRole');
  if (roleBox && !reduce) {
    const items = Array.from(roleBox.querySelectorAll<HTMLElement>('.hero-role-i'));
    if (items.length > 1) {
      let i = 0;
      setInterval(() => {
        const cur = items[i];
        i = (i + 1) % items.length;
        const next = items[i];
        cur.classList.remove('on');
        cur.classList.add('out');
        next.classList.remove('out');
        next.classList.add('on');
        // 次に出てくるときのために、外し終わったら初期位置へ戻す
        setTimeout(() => cur.classList.remove('out'), 800);
      }, 3200);
    }
  }

  /* ヒーローのにじみを、ポインタのほうへゆっくり寄せる。
     指で操作する端末と、動きを減らす設定では何もしない。 */
  const glow = document.querySelector<HTMLElement>('.hero-glow');
  const fine = window.matchMedia('(pointer: fine)').matches;
  if (glow && fine && !reduce) {
    const hero = glow.parentElement!;
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = hero.getBoundingClientRect();
        glow.style.setProperty('--gx', `${((e.clientX - r.left) / r.width) * 100}%`);
        glow.style.setProperty('--gy', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
    });
  }

  /* トップは巨大タイポを邪魔しないよう、1画面ぶんスクロールしてからヘッダーを出す */
  const head = document.querySelector('.site-head--top');
  if (head) {
    const onScroll = () => head.classList.toggle('is-shown', window.scrollY > window.innerHeight * 0.7);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* 左レール：現在地 */
  const railNow = document.getElementById('railNow');
  const marked = Array.from(document.querySelectorAll<HTMLElement>('[data-rail]'));
  if (railNow && marked.length) {
    railNow.style.transition = 'opacity .18s ease';
    // 画面の中央あたりを横切っているものを現在地とみなす。
    // 交差比で判定すると、背の高いセクションが一生ひっかからない。
    const ioR = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          const label = (e.target as HTMLElement).dataset.rail!;
          if (railNow.textContent !== label) {
            railNow.style.opacity = '0';
            setTimeout(() => { railNow.textContent = label; railNow.style.opacity = '1'; }, 180);
          }
        }
      });
    }, { threshold: 0, rootMargin: '-45% 0px -50% 0px' });
    marked.forEach((el) => ioR.observe(el));
  }
</script>
</body>
</html>
