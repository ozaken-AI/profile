---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, IDENTITY } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** OGP画像の絶対URL。省略時はサイト共通のもの */
  ogImage?: string;
  /** OGP画像の内容説明。省略時はサイト共通のもの */
  ogImageAlt?: string;
  /** 記事ページは article。省略時は website */
  ogType?: 'website' | 'article';
  /** 記事の公開日時（ISO 8601）。article のときだけ出す */
  publishedTime?: string;
  /** 左レールに出す既定の現在地 */
  railInitial?: string;
  /** このページ固有の構造化データ。トップの身元情報とは別に足される */
  jsonLd?: Record<string, unknown>[];
}
const {
  title, description, ogImage, ogImageAlt, ogType = 'website', publishedTime,
  railInitial = '現在地', jsonLd: pageJsonLd = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isTop = Astro.url.pathname === '/';
// 相対パスで渡されても絶対URLにする。第1引数が絶対URLならベースは無視される。
const ogPath = ogImage ?? '/ogp.png';
// SNS側は画像をURL単位で長く持つ。作り直したら OG_VERSION を上げて、取り直させる。
const OG_VERSION = '3';
const isOwnOg = ogPath.startsWith('/ogp');
const og = new URL(isOwnOg ? `${ogPath}?v=${OG_VERSION}` : ogPath, Astro.site).href;
// public/ogp*.png は1200×630で作ってある。
// CMSのサムネイルなど外から来た画像は大きさが分からないので寸法を書かない。
const ogSized = isOwnOg;
const ogAlt = ogImageAlt ?? '小澤健祐（おざけん）｜人間とAIが共存する社会をつくる。';
// アクセス解析。IDは Cloudflare Pages の環境変数 PUBLIC_GA_ID に入れる。
// 未設定ならタグを出さない（開発中やプレビューで数字を汚さないため）。
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;

// 検索エンジン向けの身元情報。トップにだけ置く（Googleはサイト名をトップから読む）。
// 指名検索で旧プロフィールページと競合しているので、sameAs で同一人物だと明示する。
const abs = (path: string) => new URL(path, Astro.site).href;
const identityJsonLd = !isTop ? [] : [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: IDENTITY.siteName,
    alternateName: SITE.name,
    url: SITE.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: IDENTITY.legalName,
    alternateName: IDENTITY.alternateNames,
    url: SITE.url,
    image: abs(IDENTITY.image),
    jobTitle: SITE.role.replace(/\u3000/g, ' '),
    description,
    sameAs: IDENTITY.sameAs,
  },
];
const jsonLd = [...identityJsonLd, ...pageJsonLd];
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{jsonLd.length > 0 && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
)}
<meta name="google-site-verification" content="VoBfvx8Rc4nEPbgtcl-kKaD4QOb7tVEqZIur9A2NV5o" />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og} />
<meta property="og:image:alt" content={ogAlt} />
{ogSized && (
  <>
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.xHandle} />
<meta name="twitter:creator" content={SITE.xHandle} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="theme-color" content="#0A0D13" />
<link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" sizes="any" />
<link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-96.png?v=3" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Shippori+Mincho+B1:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
{gaId && (
  <>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, {
        // 広告向けのシグナルは送らない。見たいのは流入と導線だけなので。
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
        anonymize_ip: true,
      });
    </script>
  </>
)}
<noscript><style>
  /* JSが動かない環境でも、出現アニメーション待ちで中身が消えないようにする */
  .rv,.stg>*{opacity:1!important;transform:none!important}
  .hero-eyebrow,.hero-sub,.hero-actions,.hero-foot{opacity:1!important;transform:none!important}
  .phead-h1,.h2,.contact-h{clip-path:none!important;opacity:1!important}
  .line>span{transform:none!important}
  .hero-actor,.spot-pool{opacity:1!important;animation:none!important}
  .hero-vert{opacity:1!important}
</style></noscript>
</head>
<body>

<div class="rail" aria-hidden="true">
  <div class="rail-mark">OZAKEN.AI</div>
  <div class="rail-now" id="railNow">{railInitial}</div>
  <div class="rail-prog"><i></i></div>
  <div class="rail-seal" aria-hidden="true"></div>
</div>

<SiteHeader />

<div class:list={['page', { 'has-head': !isTop }]}>
  <slot />
  <SiteFooter />
</div>

<script>
  /* 出現アニメーション ＋ 左レールの現在地表示 */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 見出しとまとまりも同じ仕組みで出す。取りこぼすと出たまま隠れるので、まとめて拾う。
  /* 計測イベント。タグが無い環境では何もしない。 */
  const track = (name: string, params: Record<string, unknown> = {}) => {
    const g = (window as any).gtag;
    if (typeof g === 'function') g('event', name, params);
  };
  (window as any).ozTrack = track;

  /* 外に出るリンクは、どこから出たかを残す */
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!a) return;
    const href = a.getAttribute('href') || '';
    if (/^https?:/.test(href) && !href.includes(location.host)) {
      track('outbound_click', { url: href, page: location.pathname });
    } else if (href === '/contact/' || href.startsWith('/contact/')) {
      track('contact_cta', { from: location.pathname, label: (a.textContent || '').trim().slice(0, 40) });
    }
  }, true);

  const ANIMATED = '.rv, .stg, .h2, .phead-h1, .contact-h';

  try {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); }
      });
      // お知らせ一覧のように画面より背の高い要素は交差比が0.12に届かない。
      // しきい値は0にして、下端の余白で「少し入ったら」を作る。
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll(ANIMATED).forEach((el) => io.observe(el));

    const hero = document.querySelector('.hero');
    if (hero) requestAnimationFrame(() => hero.classList.add('on'));
  } catch (e) {
    // 出現の仕掛けが動かなかったときに、中身が隠れたままにならないようにする
    document.querySelectorAll(ANIMATED).forEach((el) => el.classList.add('on'));
    document.querySelector('.hero')?.classList.add('on');
    console.error('[reveal]', e);
  }

  /* 桁の窓は overflow:hidden なので、外には「箱の下辺」をベースラインとして
     報告する。実際の文字はそれより少し上にあるので、その差だけ窓を沈めないと
     単位が数字に対して浮く。差は書体の寸法で決まる（Archivo とフォールバックの
     Arial では 1em あたり 4% ほど違う）ので、いま描画されている書体から測る。 */
  const odoCol = document.querySelector<HTMLElement>('.odo-col');
  if (odoCol) {
    const setDrop = () => {
      const cs = getComputedStyle(odoCol);
      const fs = parseFloat(cs.fontSize);
      const ctx = document.createElement('canvas').getContext('2d');
      if (!ctx) return;
      ctx.font = `${cs.fontWeight} ${fs}px ${cs.fontFamily}`;
      const m = ctx.measureText('0');
      const a = m.fontBoundingBoxAscent, d = m.fontBoundingBoxDescent;
      if (!a || !d) return;
      const drop = (fs - (a + d)) / 2 + d;   // 行の余白の半分＋ディセンダ
      document.querySelectorAll<HTMLElement>('.odo')
        .forEach((el) => el.style.setProperty('--odo-drop', (drop / fs).toFixed(4) + 'em'));
    };
    setDrop();
    document.fonts?.ready.then(setDrop);   // 書体が差し替わったら測り直す
  }

  /* 数字のオドメーター。見えたら .on を付けるだけで、あとはCSSが帯を送る。
     付けそこねても、静止状態がそのまま最終値なので数字は正しく出る。 */
  const ioN = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('on'); ioN.unobserve(e.target); } });
  }, { threshold: 0.4 });
  document.querySelectorAll<HTMLElement>('.num').forEach((el) => ioN.observe(el));

  /* ヒーローの肩書きを順に入れ替える */
  const roleBox = document.getElementById('heroRole');
  if (roleBox && !reduce) {
    const items = Array.from(roleBox.querySelectorAll<HTMLElement>('.hero-role-i'));
    if (items.length > 1) {
      let i = 0;
      setInterval(() => {
        const cur = items[i];
        i = (i + 1) % items.length;
        const next = items[i];
        cur.classList.remove('on');
        cur.classList.add('out');
        next.classList.remove('out');
        next.classList.add('on');
        // 次に出てくるときのために、外し終わったら初期位置へ戻す
        setTimeout(() => cur.classList.remove('out'), 800);
      }, 3200);
    }
  }

  /* トップは見出しから読み始め、少しスクロールしたらナビゲーションを出す */
  const head = document.querySelector('.site-head--top');
  if (head) {
    const onScroll = () => head.classList.toggle('is-shown', window.scrollY > window.innerHeight * 0.45);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* 左レール：現在地 */
  const railNow = document.getElementById('railNow');
  const marked = Array.from(document.querySelectorAll<HTMLElement>('[data-rail]'));
  if (railNow && marked.length) {
    railNow.style.transition = 'opacity .18s ease';
    // 画面の中央あたりを横切っているものを現在地とみなす。
    // 交差比で判定すると、背の高いセクションが一生ひっかからない。
    const ioR = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          const label = (e.target as HTMLElement).dataset.rail!;
          if (railNow.textContent !== label) {
            railNow.style.opacity = '0';
            setTimeout(() => { railNow.textContent = label; railNow.style.opacity = '1'; }, 180);
          }
        }
      });
    }, { threshold: 0, rootMargin: '-45% 0px -50% 0px' });
    marked.forEach((el) => ioR.observe(el));
  }
</script>
</body>
</html>
